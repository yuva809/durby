{
  "scenario": "INV-T1 cash purchase bill (no tax): 2 x BEV-WAT-004 @20.00 (FIFO), 2 x CHOC-003 @17.00 (weighted avg), note TEST-DURBY-INV-T1 (user-approved)",
  "sequence": [
    {"op":"go","path":"/inventory/adjustment"},
    {"op":"go","path":"/inventory/6c8d320e-ffdd-43c3-92e4-0c963d3c9b6b"},
    {"op":"go","path":"/inventory/9c5b6bc1-e593-4eda-9199-e1ba66e36b11"},
    {"op":"go","path":"/accounting-workbench"},
    {"op":"go","path":"/accounts"},
    {"op":"go","path":"/reports/inventory-position"},
    {"op":"go","path":"/purchases/bills/create"},
    {"op":"click","text":"Cash Purchase","optional":true,"wait":1200},
    {"op":"fill","match":"Search product","value":"BEV-WAT-004","nth":0,"wait":2500},
    {"op":"clickOption","prefix":"Mineral Water","wait":1500},
    {"op":"fill","match":"Qty","value":"2","nth":0,"wait":500},
    {"op":"fill","match":"Rate","value":"20","nth":0,"wait":500},
    {"op":"click","text":"Add Row","wait":1200},
    {"op":"fill","match":"Search product","value":"CHOC-003","nth":-1,"wait":2500},
    {"op":"clickOption","prefix":"Munch Chocolate","wait":1500},
    {"op":"fill","match":"Qty","value":"2","nth":-1,"wait":500},
    {"op":"fill","match":"Rate","value":"17","nth":-1,"wait":500},
    {"op":"fill","match":"Notes","value":"TEST-DURBY-INV-T1","wait":500},
    {"op":"snapshot","label":"filled form","scope":"body"},
    {"op":"act","text":"Save","wait":5000},
    {"op":"snapshot","label":"after save","scope":"body"},
    {"op":"wait","ms":3000},
    {"op":"go","path":"/inventory/adjustment"},
    {"op":"go","path":"/inventory/6c8d320e-ffdd-43c3-92e4-0c963d3c9b6b"},
    {"op":"go","path":"/inventory/9c5b6bc1-e593-4eda-9199-e1ba66e36b11"},
    {"op":"go","path":"/accounting-workbench"},
    {"op":"clickNthRow","n":0},
    {"op":"escape"},
    {"op":"go","path":"/purchases/bills"},
    {"op":"clickNthRow","n":0},
    {"op":"go","path":"/accounts"},
    {"op":"go","path":"/reports/inventory-position"}
  ],
  "allow": [{
    "method": "POST", "path": "^/api/core/purchases/bills$", "once": true,
    "expect": "b && Array.isArray(b.lines) && b.lines.length === 2 && b.lines[0].productId === '6c8d320e-ffdd-43c3-92e4-0c963d3c9b6b' && Number(b.lines[0].quantity) === 2 && b.lines[0].unitPrice === '20.00' && b.lines[1].productId === '9c5b6bc1-e593-4eda-9199-e1ba66e36b11' && Number(b.lines[1].quantity) === 2 && b.lines[1].unitPrice === '17.00' && !b.lines[0].discountAmount && !b.lines[0].discountPercent && !b.lines[1].discountAmount && !b.lines[1].discountPercent && b.customFields && b.customFields.tax_option === 'no_vat' && b.customFields.cash_transaction === true && !b.partyId && !b.charges && !b.discountAmount && !b.discountPercent && typeof b.notes === 'string' && b.notes.includes('TEST-DURBY-INV-T1') && (b.settledAmount === undefined || b.settledAmount === '74.00')"
  }],
  "maxWrites": 1,
  "getFilters": {
    "^/api/core/stock/levels$": {"list":"","fields":["productId","warehouseId","onHand","reserved","available","avgCost"]},
    "^/api/core/stock/movements$": {"list":"data","top":6,"fields":["productId","movementType","sourceType","sourceId","quantity","unitCost","reason","batches","createdAt"]},
    "^/api/core/reports/business/inventory-ledger$": {"pick":["sections"]},
    "^/api/accounting/journals$": {"list":"data","top":3,"fields":["id","journalNumber","status","sourceEventType","sourceDocumentNumber","totalDebit","createdAt"]},
    "^/api/accounting/journals/[^/]+$": {"fieldsObj":["journalNumber","status","sourceEventType","sourceDocumentNumber","totalDebit","totalCredit","lines"]},
    "^/api/core/documents$": {"list":"data","top":2,"fields":["id","documentNumber","documentType","status","isDraft","subTotal","taxTotal","grandTotal","balanceDue","settledAmount","warehouseId","createdAt"]},
    "^/api/core/documents/[^/]+$": {"fieldsObj":["documentNumber","documentType","status","isDraft","subTotal","taxTotal","grandTotal","balanceDue","settledAmount","settlementStatus","settlementAccountId","warehouseId","lines","payments","customFields","notes"]},
    "^/api/core/accounts$": {"list":"","fields":["accountKind","isDefault","balance"]},
    "^/api/core/reports/business/inventory-position$": {"pick":["rowCount","totals"]}
  },
  "keepRegisterNames": [], "settleMs": 3500
}
