#!/usr/bin/env bash
# docker compose for the staging stack, with .env and the deployed IMAGE_TAG filled in.
# Usage (on the server, as deploy): /opt/durby/bin/dc ps | logs -f api | exec postgres psql -U postgres durby
set -euo pipefail

DEPLOY_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# deploy.sh exports IMAGE_TAG for the release it is rolling out; otherwise use the deployed one.
if [[ -z "${IMAGE_TAG:-}" && -f "$DEPLOY_DIR/state/deployed.sha" ]]; then
  IMAGE_TAG="$(cat "$DEPLOY_DIR/state/deployed.sha")"
fi
export IMAGE_TAG="${IMAGE_TAG:-none}"

env_value() { sed -n "s/^$1=//p" "$DEPLOY_DIR/.env" 2>/dev/null | tail -n 1 | tr -d "'\""; }

# A second stack on this host (ADR 0034) has its own project name and no edge (Caddy) of its own.
project=()
name="$(env_value COMPOSE_PROJECT_NAME)"
[[ -n "$name" ]] && project=(-p "$name")
if [[ -z "${COMPOSE_PROFILES:-}" && "$(env_value EDGE)" != false ]]; then
  export COMPOSE_PROFILES=edge
fi

exec docker compose \
  "${project[@]}" \
  --project-directory "$DEPLOY_DIR" \
  -f "$DEPLOY_DIR/docker-compose.staging.yml" \
  --env-file "$DEPLOY_DIR/.env" \
  "$@"
