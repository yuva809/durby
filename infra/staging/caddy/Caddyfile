# Durby staging edge: TLS (Let's Encrypt), routing, request ids, access logs.
# Values come from the server's .env via docker-compose.staging.yml.
{
	email {$ACME_EMAIL}
}

# Both domains of the two-domain demo (ADR 0015 §10): same routes, one certificate each. Web and api
# read the original Host (Caddy passes it on and sets X-Forwarded-Host) to pick the partner theme.
{$STAGING_DOMAIN}, {$STAGING_DEMO_DOMAIN} {
	encode zstd gzip

	# One id per request, shared with the api logs. Client-supplied ids are overwritten.
	request_header X-Request-Id {http.request.uuid}
	log_append request_id {http.request.uuid}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Staging is public since ADR 0018 (no basic auth): keep it out of search engines.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Caddy already redacts Authorization/Cookie headers; drop query strings too (may hold tokens).
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*$" "?[REDACTED]"
			}
		}
	}

	handle /api/* {
		reverse_proxy api:4000
	}

	# Web: no basic auth since ADR 0018; the app's own sign-in protects it.
	handle {
		reverse_proxy web:3000
	}
}
