# Template for /opt/durby/.env on the staging server. server-setup.sh writes the real file
# with generated secrets (mode 600, owner deploy). NEVER commit the real file.
# Values in single quotes are taken literally by Docker Compose (needed for the bcrypt hash).

# Postgres superuser: only used by Postgres itself, backups and restores. Never by the app.
POSTGRES_SUPERUSER_PASSWORD=change-me
# durby_migrator: schema owner, used only by the migrate release step.
DURBY_MIGRATOR_PASSWORD=change-me
# durby_app: the running api (no BYPASSRLS).
DURBY_APP_PASSWORD=change-me
REDIS_PASSWORD=change-me
# HS256 secret for access tokens (step 1.2), at least 32 characters: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me
# Optional: email domains that can be invited as Durby staff (default durby.tech).
# STAFF_EMAIL_DOMAINS=durby.tech

STAGING_DOMAIN=staging.durby.tech
# Second domain of the two-domain demo: the demo partner's theme (ADR 0015 §10). DNS: CNAME to
# STAGING_DOMAIN. Removed with the demo partner before production.
STAGING_DEMO_DOMAIN=partner-demo.durby.tech
# Let's Encrypt account / expiry notices.
ACME_EMAIL=ops@example.com
# Basic auth in front of the web app (not /api/*). Hash: docker run --rm caddy:2-alpine caddy hash-password
BASIC_AUTH_USER=durby
BASIC_AUTH_HASH='$2a$14$replace.with.a.real.bcrypt.hash'

LOG_LEVEL=info
# Optional: sender of staging mail. Default: Durby Staging <no-reply@staging.invalid>. With a real SMTP_URL
# it must be an address on a domain verified at the provider.
# MAIL_FROM=Durby Staging <no-reply@staging.durby.tech>
# Optional: SMTP relay for staging mail. Unset (default): everything lands in Mailpit and nothing leaves the
# server. Set it and mail goes to REAL inboxes. smtp:// or smtps:// only; keep the value in single quotes and
# URL-encode special characters in the password (e.g. Resend: smtps://resend:<api key>@smtp.resend.com:465).
# SMTP_URL='smtps://resend:re_xxx@smtp.resend.com:465'
# Registry and image name prefix; images are <prefix>-api, <prefix>-api-migrate, <prefix>-web.
IMAGE_PREFIX=ghcr.io/yuva809/durby

# Backups (bin/backup.sh). rclone remote:path for the Hetzner Storage Box.
BACKUP_RCLONE_REMOTE=storagebox:durby-staging
# age public key (age1...). The matching private key is kept OFF the server.
BACKUP_AGE_RECIPIENT=
# Optional: URL pinged after each successful backup (e.g. a healthchecks.io check).
BACKUP_HEARTBEAT_URL=
