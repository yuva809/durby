# Template for /opt/durby/.env on the staging server. server-setup.sh writes the real file
# with generated secrets (mode 600, owner deploy). NEVER commit the real file.
# Values in single quotes are taken literally by Docker Compose (needed for the bcrypt hash).

# Postgres superuser: only used by Postgres itself, backups and restores. Never by the app.
POSTGRES_SUPERUSER_PASSWORD=change-me
# durby_migrator: schema owner, used only by the migrate release step.
DURBY_MIGRATOR_PASSWORD=change-me
# durby_app: the running api (no BYPASSRLS).
DURBY_APP_PASSWORD=change-me
REDIS_PASSWORD=change-me
# HS256 secret for access tokens (step 1.2), at least 32 characters: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me
# Optional: email domains that can be invited as Durby staff (default durby.tech).
# STAFF_EMAIL_DOMAINS=durby.tech

# The stack's main domain: sign-in, email links and the api (WEB_BASE_URL). Production (main, /opt/durby) uses
# app.durby.tech since ADR 0039; the dev stack uses dev.durby.tech. The name stays STAGING_DOMAIN for older servers.
STAGING_DOMAIN=app.durby.tech
# Second domain of the two-domain demo: the demo partner's theme (ADR 0015 §10). DNS: CNAME to
# STAGING_DOMAIN. Removed with the demo partner before production.
STAGING_DEMO_DOMAIN=partner-demo.durby.tech
# Optional, edge stack only: former domains that redirect permanently (308) to STAGING_DOMAIN, comma-separated
# (ADR 0039). Their /downloads/android/ stays served so installed Android apps keep updating. DNS: A record to this
# server, kept as long as old links and apps exist.
# REDIRECT_DOMAINS=staging.durby.tech
# Optional, edge stack only: partners' own domains on this stack, comma-separated https origins (ADR 0040). Each is
# added to WEB_ORIGINS and gets a Caddy site; its theme comes from a partner_domains row (a migration). DNS: A record
# to this server.
# PARTNER_ORIGINS=https://dev.asiamight.site
# Let's Encrypt account / expiry notices.
ACME_EMAIL=ops@example.com

LOG_LEVEL=info
# Optional: Postgres pool and Prisma transaction limits per process (ADR 0021). Defaults: 10, 2000, 5000.
# DATABASE_POOL_SIZE=10
# PRISMA_TX_MAX_WAIT_MS=2000
# PRISMA_TX_TIMEOUT_MS=5000
# Optional: sender of staging mail. Default: Durby Staging <no-reply@staging.invalid>. With a real SMTP_URL
# it must be an address on a domain verified at the provider.
# MAIL_FROM=Durby <no-reply@app.durby.tech>
# Optional: SMTP relay for staging mail. Unset (default): everything lands in Mailpit and nothing leaves the
# server. Set it and mail goes to REAL inboxes. smtp:// or smtps:// only; keep the value in single quotes and
# URL-encode special characters in the password (e.g. Resend: smtps://resend:<api key>@smtp.resend.com:465).
# SMTP_URL='smtps://resend:re_xxx@smtp.resend.com:465'
# The branch this stack deploys with bin/release.sh (ADR 0034): main for production, development for the dev
# stack (/opt/durby-dev).
DEPLOY_BRANCH=main
# Optional: where bin/release.sh clones the source (default https://github.com/yuva809/durby.git). For a private
# repository use the SSH URL with a read-only deploy key: git@github.com:yuva809/durby.git
# DEPLOY_REPO=git@github.com:yuva809/durby.git
# Second stack on the same server only (bin/add-stack.sh writes these, ADR 0034): own project, no Caddy, unique
# names on the shared network and a smaller Postgres. Production leaves them unset.
# COMPOSE_PROJECT_NAME=durby-dev
# EDGE=false
# SHARED_ALIAS=dev
# MAILPIT_UI_PORT=8026
# POSTGRES_MEMORY=512m
# POSTGRES_SHARED_BUFFERS=128MB
# POSTGRES_CACHE_SIZE=256MB
# Registry and image name prefix; images are <prefix>-api, <prefix>-api-migrate, <prefix>-web.
IMAGE_PREFIX=ghcr.io/yuva809/durby

# Backups (bin/backup.sh). rclone remote:path for the Hetzner Storage Box.
# One folder per stack: production keeps durby-staging, the dev stack uses durby-development.
BACKUP_RCLONE_REMOTE=storagebox:durby-staging
# age public key (age1...). The matching private key is kept OFF the server.
BACKUP_AGE_RECIPIENT=
# Optional: URL pinged after each successful backup (e.g. a healthchecks.io check).
BACKUP_HEARTBEAT_URL=
