{
  "name": "durby",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @durby/api db:generate",
    "db:roles": "sh infra/postgres/apply-roles.sh",
    "db:migrate": "pnpm --filter @durby/api db:migrate"
  },
  "devDependencies": {
    "@durby/config": "workspace:*",
    "prettier": "^3.9.10",
    "turbo": "2.11.9",
    "typescript": "~6.0.3"
  }
}
