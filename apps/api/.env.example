# Copy to apps/api/.env for local development. Values match docker-compose.yml and
# infra/postgres/init/01-roles.sql (local-only passwords). If you changed
# DURBY_POSTGRES_PORT / DURBY_REDIS_PORT in the root .env, change the ports here too.

# development | test | production
NODE_ENV=development
# HTTP port of the API.
PORT=4000
# fatal | error | warn | info | debug | trace | silent. JSON in production, pretty-printed in development.
LOG_LEVEL=info
# Used by the running app. Connects as durby_app (no BYPASSRLS, so RLS applies).
DATABASE_URL=postgresql://durby_app:durby_app@localhost:5432/durby
# Used only by the Prisma CLI (migrations). Connects as durby_migrator (schema owner).
MIGRATION_DATABASE_URL=postgresql://durby_migrator:durby_migrator@localhost:5432/durby
# Redis for queues (BullMQ) and caching.
REDIS_URL=redis://localhost:6379

# --- Auth (docs/platform/auth.md) ---
# HS256 signing secret for access tokens, at least 32 characters. Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=local-dev-only-change-me-0123456789abcdef
# Access token lifetime in seconds (60-900).
JWT_ACCESS_TTL_SECONDS=600
# Exact origins allowed on the cookie endpoints (comma-separated). The web app's origins: locally the
# two-domain demo (docs/platform/web-shell.md) on *.localhost besides plain localhost.
WEB_ORIGINS=http://localhost:3000,http://durby.localhost:3000,http://partner-demo.localhost:3000
# Base URL of links in emails (password reset, verification).
WEB_BASE_URL=http://localhost:3000
# Keep true: Chromium/Firefox accept Secure cookies on http://localhost. Set false only if your browser
# (e.g. Safari) drops the refresh cookie locally; the cookie is then named durby_rt. Never false in production.
COOKIE_SECURE=true
# Reverse proxies in front of the api: 1 locally (the Next.js rewrite and server-side fetches send
# X-Forwarded-Host for the partner theme, ADR 0015) and on staging (Caddy).
TRUST_PROXY=1

# --- Mail ---
# Mailpit from docker-compose.yml; UI at http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Durby <no-reply@durby.local>

# --- Staff / admin portal (docs/platform/admin-portal.md) ---
# Email domains that can be invited as Durby staff (comma-separated).
STAFF_EMAIL_DOMAINS=durby.local,durby.tech
