# Copy to apps/api/.env for local development. Values match docker-compose.yml and
# infra/postgres/init/01-roles.sql (local-only passwords). If you changed
# DURBY_POSTGRES_PORT / DURBY_REDIS_PORT in the root .env, change the ports here too.

# development | test | production
NODE_ENV=development
# HTTP port of the API.
PORT=4000
# fatal | error | warn | info | debug | trace | silent. JSON in production, pretty-printed in development.
LOG_LEVEL=info
# Used by the running app. Connects as durby_app (no BYPASSRLS, so RLS applies).
DATABASE_URL=postgresql://durby_app:durby_app@localhost:5432/durby
# Used only by the Prisma CLI (migrations). Connects as durby_migrator (schema owner).
MIGRATION_DATABASE_URL=postgresql://durby_migrator:durby_migrator@localhost:5432/durby
# Redis for queues (BullMQ) and caching.
REDIS_URL=redis://localhost:6379
