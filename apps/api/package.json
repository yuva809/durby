{
  "name": "@durby/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "seed:dev": "nest build && node dist/cli/seed-dev.js",
    "create-admin": "nest build && node dist/cli/create-admin.js",
    "create-staff": "nest build && node dist/cli/create-staff.js",
    "entitlements": "nest build && node dist/cli/entitlements.js",
    "outbox": "nest build && node dist/cli/outbox.js",
    "rbac:split": "nest build && node dist/cli/rbac-split.js",
    "worker": "nest build && node dist/worker.js",
    "dev:worker": "nest start --watch --entryFile worker"
  },
  "dependencies": {
    "@durby/i18n": "workspace:*",
    "@durby/shared": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "6.3.11",
    "cookie-parser": "^1.4.7",
    "decimal.js": "10.6.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "nestjs-cls": "7.0.1",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.2.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@durby/config": "workspace:*",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.18",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "3.6.4",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
