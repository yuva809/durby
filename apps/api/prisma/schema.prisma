enum StockRequestStatus {
  submitted
  approved
  picking
  packed
  in_transit
  delivered
  received
  rejected
  cancelled

  @@map("stock_request_status")
}

/// A branch's request for goods from a warehouse (ADR 0045); becomes a transfer (transferNumber) when approved.
model StockRequest {
  id                String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  number            String
  transferNumber    String?             @map("transfer_number")
  status            StockRequestStatus  @default(submitted)
  /// The branch: the destination warehouse's location.
  locationId        String              @map("location_id") @db.Uuid
  /// The source warehouse's location (the warehouse's keys are checked there).
  fromLocationId    String              @map("from_location_id") @db.Uuid
  fromWarehouseId   String              @map("from_warehouse_id") @db.Uuid
  /// Null when branches keep no stock (orders.branchStores off, ADR 0080): the goods leave the source on delivery.
  toWarehouseId     String?             @map("to_warehouse_id") @db.Uuid
  note              String?
  requestedByUserId String              @map("requested_by_user_id") @db.Uuid
  driverUserId      String?             @map("driver_user_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location          Location            @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  fromWarehouse     Warehouse           @relation("StockRequestFrom", fields: [tenantId, fromWarehouseId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  toWarehouse       Warehouse?          @relation("StockRequestTo", fields: [tenantId, toWarehouseId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  lines             StockRequestLine[]
  events            StockRequestEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, transferNumber])
  @@index([tenantId, status, id])
  @@index([tenantId, driverUserId])
  @@map("stock_requests")
}

/// One item of a request: asked, approved, picked and received quantities.
model StockRequestLine {
  id               String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  requestId        String       @map("request_id") @db.Uuid
  itemId           String       @map("item_id") @db.Uuid
  quantity         Decimal      @db.Decimal(14, 3)
  approvedQuantity Decimal?     @map("approved_quantity") @db.Decimal(14, 3)
  pickedQuantity   Decimal?     @map("picked_quantity") @db.Decimal(14, 3)
  receivedQuantity Decimal?     @map("received_quantity") @db.Decimal(14, 3)
  /// Not requested: the warehouse added it at packing (item 9); quantity is what was packed.
  addedAtPacking   Boolean      @default(false) @map("added_at_packing")
  sortOrder        Int          @default(0) @map("sort_order")
  organization     Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  request          StockRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  item             StockItem    @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, requestId, itemId])
  @@map("stock_request_lines")
}

/// The timeline of a request: one row per status it reached. Append-only.
model StockRequestEvent {
  id           String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  requestId    String             @map("request_id") @db.Uuid
  status       StockRequestStatus
  note         String?
  userId       String?            @map("user_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  request      StockRequest       @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, requestId, id])
  @@map("stock_request_events")
}

/// A notification for one person (ADR 0047), written in the transaction of the change. Read, never deleted.
model Notification {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  /// No FK: notifications outlive memberships.
  userId       String       @map("user_id") @db.Uuid
  /// A NOTIFICATION_KINDS key (shape checked in SQL).
  kind         String
  entityType   String       @map("entity_type")
  entityId     String       @map("entity_id") @db.Uuid
  /// What the text needs: numbers and names, never free text or contact details.
  params       Json         @default("{}")
  readAt       DateTime?    @map("read_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, userId, id])
  @@map("notifications")
}

/// A person's choice per kind (ADR 0047); missing rows mean the default (NOTIFICATION_EMAIL_BY_DEFAULT).
