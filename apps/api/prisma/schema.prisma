  location        Location                  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  publications    PosFloorPlanPublication[]

  @@unique([tenantId, id])
  @@unique([tenantId, areaId, version])
  /// Target of the publication's FK: a publication is of a version of its own area and location.
  @@unique([tenantId, locationId, areaId, id])
  @@map("pos_floor_plan_versions")
}

/// Which version of an area's plan is live (ADR 0073): the newest row. Append-only.
model PosFloorPlanPublication {
