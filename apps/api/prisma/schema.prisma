/// A saved floor plan of an area (ADR 0073). Append-only; the area has no FK because its history outlives it.
model PosFloorPlanVersion {
  id              String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String                    @map("tenant_id") @db.Uuid
  locationId      String                    @map("location_id") @db.Uuid
  areaId          String                    @map("area_id") @db.Uuid
  version         Int
  restoredFrom    Int?                      @map("restored_from")
  /// floorPlanLayoutSchema (packages/shared).
  layout          Json
  createdByUserId String                    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
