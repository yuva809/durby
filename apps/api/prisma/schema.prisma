  /// Insertion order.
  seq             BigInt              @unique @default(autoincrement())
  tenantId        String              @map("tenant_id") @db.Uuid
  locationId      String              @map("location_id") @db.Uuid
  areaId          String              @map("area_id") @db.Uuid
  versionId       String              @map("version_id") @db.Uuid
  createdByUserId String              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  version         PosFloorPlanVersion @relation(fields: [tenantId, locationId, areaId, versionId], references: [tenantId, locationId, areaId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, areaId, seq])
  @@map("pos_floor_plan_publications")
