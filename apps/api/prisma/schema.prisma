// Reservations (docs/modules/reservations.md, ADR 0019). Hand-written SQL in the reservations migration: btree_gist,
// the exclusion constraint on reservation_tables, the period/blocking triggers, CHECKs, the guest email index, RLS.

enum ReservationStatus {
  /// Online party above online.instantMaxParty: the host accepts or declines. Blocks no table.
  requested
  /// Online within instantMaxParty while autoConfirm is off: tables held; the host confirms or declines; expires.
  pending
  booked
  arrived
  seated
  finished
  no_show
  cancelled
  declined
  expired

  @@map("reservation_status")
}

enum ReservationSource {
  staff
  online
  walk_in

  @@map("reservation_source")
}

enum TableBookingMode {
  /// Staff and online.
  all
  /// Never offered online.
  staff_only
  /// Never booked; walk-ins only.
  walk_in_only

  @@map("table_booking_mode")
}

/// Reservation rules of a dining table (one row per table that has any; none = the defaults).
model ReservationTableRule {
  tenantId     String           @map("tenant_id") @db.Uuid
  tableId      String           @map("table_id") @db.Uuid
  locationId   String           @map("location_id") @db.Uuid
  bookingMode  TableBookingMode @default(all) @map("booking_mode")
  minParty     Int              @default(1) @map("min_party")
  /// null = the table's seats.
  maxParty     Int?             @map("max_party")
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  table        DiningTable      @relation(fields: [tenantId, tableId, locationId], references: [tenantId, id, locationId], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, tableId])
  @@map("reservation_table_rules")
}

/// A location's online booking page (R2.1, ADR 0085): `/b/{slug}` on its partner's domain. The slug is unique across
/// every tenant; the public routes find it through `booking_page_by_slug()` only.
model ReservationBookingPage {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  locationId   String       @map("location_id") @db.Uuid
  slug         String       @unique
  enabled      Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location     Location     @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, locationId])
  @@map("reservation_booking_pages")
}

/// Tables that can be pushed together for one party.
model ReservationCombination {
  id             String                        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String                        @map("tenant_id") @db.Uuid
  locationId     String                        @map("location_id") @db.Uuid
  name           String
  minParty       Int                           @map("min_party")
  maxParty       Int                           @map("max_party")
  onlineBookable Boolean                       @default(true) @map("online_bookable")
  archivedAt     DateTime?                     @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location       Location                      @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  tables         ReservationCombinationTable[]

  @@unique([tenantId, id])
  @@unique([tenantId, locationId, id])
  @@index([tenantId, locationId])
  @@map("reservation_combinations")
}

model ReservationCombinationTable {
  tenantId      String                 @map("tenant_id") @db.Uuid
  combinationId String                 @map("combination_id") @db.Uuid
  locationId    String                 @map("location_id") @db.Uuid
  tableId       String                 @map("table_id") @db.Uuid
  organization  Organization           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  combination   ReservationCombination @relation(fields: [tenantId, locationId, combinationId], references: [tenantId, locationId, id], onDelete: Cascade, onUpdate: Restrict)
  table         DiningTable            @relation(fields: [tenantId, tableId, locationId], references: [tenantId, id, locationId], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, combinationId, tableId])
  @@index([tenantId, tableId])
  @@map("reservation_combination_tables")
}

/// A guest of the organization: minimal personal data, reused per email, anonymised by retention (Q8).
model ReservationGuest {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  /// null once anonymised.
  name         String?
  /// Lower-case; one live guest per email per organization (partial unique index, hand-written).
  email        String?
  /// E.164.
  phone        String?
  locale       String
  /// Set when one of their reservations finishes (retention clock).
  lastVisitAt  DateTime?     @map("last_visit_at") @db.Timestamptz(6)
  anonymisedAt DateTime?     @map("anonymised_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reservations Reservation[]

  @@unique([tenantId, id])
  @@map("reservation_guests")
}

/// The current state of a booking; its history is reservation_status_changes plus the audit log.
model Reservation {
  id              String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String                    @map("tenant_id") @db.Uuid
  locationId      String                    @map("location_id") @db.Uuid
  /// RES-{YYYY}-{seq:6}, series reservations.booking: the guest-facing reference.
  number          String
  guestId         String                    @map("guest_id") @db.Uuid
  partySize       Int                       @map("party_size")
  startsAt        DateTime                  @map("starts_at") @db.Timestamptz(6)
  /// starts_at + turn time; > starts_at.
  endsAt          DateTime                  @map("ends_at") @db.Timestamptz(6)
  status          ReservationStatus
  source          ReservationSource
  /// Free text: never in audit snapshots, events or logs.
  guestNote       String?                   @map("guest_note")
  staffNote       String?                   @map("staff_note")
  /// Self-cancel link (R2); the token embeds the organization id.
  manageTokenHash String?                   @unique @map("manage_token_hash")
  /// null for online bookings; no FK (users are private to platform/auth, ADR 0016 §8).
  createdByUserId String?                   @map("created_by_user_id") @db.Uuid
  arrivedAt       DateTime?                 @map("arrived_at") @db.Timestamptz(6)
  seatedAt        DateTime?                 @map("seated_at") @db.Timestamptz(6)
  finishedAt      DateTime?                 @map("finished_at") @db.Timestamptz(6)
  cancelledAt     DateTime?                 @map("cancelled_at") @db.Timestamptz(6)
  noShowAt        DateTime?                 @map("no_show_at") @db.Timestamptz(6)
  reminderSentAt  DateTime?                 @map("reminder_sent_at") @db.Timestamptz(6)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location        Location                  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  guest           ReservationGuest          @relation(fields: [tenantId, guestId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  tables          ReservationTable[]
  changes         ReservationStatusChange[]
  waitlistEntry   WaitlistEntry?

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, locationId, startsAt])
  @@index([tenantId, status, endsAt])
  @@index([tenantId, guestId])
  @@map("reservations")
}

enum WaitlistStatus {
  waiting
  notified
  seated
  left
  removed

  @@map("waitlist_status")
}

enum WaitlistChannel {
  email
  in_person

  @@map("waitlist_channel")
}

enum WaitlistNoticeResult {
  pending
  sent
  failed

  @@map("waitlist_notice_result")
}

/// A party waiting for a table (ADR 0084). Contact data stays until a day after the entry ended.
model WaitlistEntry {
  id              String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  locationId      String                @map("location_id") @db.Uuid
  /// Personal data (with phone, email, note): null once erased; never in audit, events or logs.
  name            String?
  /// E.164.
  phone           String?
  email           String?
  note            String?
  locale          String
  partySize       Int                   @map("party_size")
  quotedMinutes   Int?                  @map("quoted_minutes")
  status          WaitlistStatus        @default(waiting)
  notifiedAt      DateTime?             @map("notified_at") @db.Timestamptz(6)
  noticeChannel   WaitlistChannel?      @map("notice_channel")
  noticeResult    WaitlistNoticeResult? @map("notice_result")
  emailedAt       DateTime?             @map("emailed_at") @db.Timestamptz(6)
  emailCount      Int                   @default(0) @map("email_count")
  endedAt         DateTime?             @map("ended_at") @db.Timestamptz(6)
  erasedAt        DateTime?             @map("erased_at") @db.Timestamptz(6)
  reservationId   String?               @map("reservation_id") @db.Uuid
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location        Location              @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  reservation     Reservation?          @relation(fields: [tenantId, reservationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, reservationId])
  @@index([tenantId, locationId, status, createdAt])
  @@index([tenantId, locationId, endedAt])
  @@map("waitlist_entries")
}

/// The tables of a reservation with its period; the exclusion constraint (ADR 0019) works on these rows.
model ReservationTable {
  tenantId      String                   @map("tenant_id") @db.Uuid
  reservationId String                   @map("reservation_id") @db.Uuid
  locationId    String                   @map("location_id") @db.Uuid
  tableId       String                   @map("table_id") @db.Uuid
  /// tstzrange(starts_at, ends_at, '[)'), kept equal to the reservation by trigger.
  period        Unsupported("tstzrange")
  /// status in (pending, booked, arrived, seated), kept by trigger.
  blocking      Boolean
  organization  Organization             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reservation   Reservation              @relation(fields: [tenantId, reservationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  table         DiningTable              @relation(fields: [tenantId, tableId, locationId], references: [tenantId, id, locationId], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, reservationId, tableId])
  @@index([tenantId, tableId])
  @@map("reservation_tables")
}

/// Append-only history of status changes; an undo appends a change pointing at the one it reverts.
model ReservationStatusChange {
  id               String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  reservationId    String             @map("reservation_id") @db.Uuid
  /// null on creation.
  fromStatus       ReservationStatus? @map("from_status")
  toStatus         ReservationStatus  @map("to_status")
  undoesId         String?            @map("undoes_id") @db.Uuid
  /// null for guest and system actors.
  actorUserId      String?            @map("actor_user_id") @db.Uuid
  /// user | guest | system
  actorKind        String             @map("actor_kind")
  /// What the change replaced, so an undo restores it (R1.6c); null on creation.
  previousStartsAt DateTime?          @map("previous_starts_at") @db.Timestamptz(6)
  previousEndsAt   DateTime?          @map("previous_ends_at") @db.Timestamptz(6)
  previousTableIds String[]           @map("previous_table_ids") @db.Uuid
  /// The till order behind a system change (auto-seat on pos.order.opened, finish on pos.order.closed); no FK:
  /// pos's table, referenced by id only (R1.7).
  sourceOrderId    String?            @map("source_order_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  organization     Organization       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reservation      Reservation        @relation(fields: [tenantId, reservationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, reservationId, createdAt])
  @@map("reservation_status_changes")
}

// ---------------------------------------------------------------------------
// Inventory module: warehouses and the stock ledger (docs/modules/inventory.md, ADR 0027). Private to
// modules/inventory.
// ---------------------------------------------------------------------------

enum StockUnit {
  kg
  g
  l
  ml
  pc
  box
  bucket
  bag
  packet

  @@map("stock_unit")
}

enum StockDocumentKind {
  receipt
  adjustment
  transfer
  consumption
  production
  issue
  restock
  /// Goods a branch received out of In transit when branches keep no stock (ADR 0080): out only, no destination.
  delivery

  @@map("stock_document_kind")
}

enum StockAdjustmentReason {
  waste
  breakage
  count
  other
  correction

  @@map("stock_adjustment_reason")
}

/// A store at a location (main store, kitchen, bar, cold room). Archived, never deleted.
model Warehouse {
  id                  String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  locationId          String          @map("location_id") @db.Uuid
  name                String
  sortOrder           Int             @default(0) @map("sort_order")
  /// Sales of this station at the location take their stock from here (warehouses_supplies_station_key).
  suppliesStation     PrepStation?    @map("supplies_station")
  /// The organization's "In transit" warehouse (ADR 0045): one at most (partial unique index).
  isTransit           Boolean         @default(false) @map("is_transit")
  /// Supplies every branch (ADR 0053): branch requests come from it. At most one active per organization.
  isMain              Boolean         @default(false) @map("is_main")
  /// The branches (locations) it supplies (ADR 0067); empty: none, or every branch for the main one.
  suppliesLocationIds String[]        @default([]) @map("supplies_location_ids") @db.Uuid
  archivedAt          DateTime?       @map("archived_at") @db.Timestamptz(6)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location            Location        @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  documents           StockDocument[] @relation("StockDocumentWarehouse")
  incoming            StockDocument[] @relation("StockDocumentToWarehouse")
  movements           StockMovement[]
  levels              StockLevel[]
  salesOrders         SalesOrder[]
  requestsFrom        StockRequest[]  @relation("StockRequestFrom")
  requestsTo          StockRequest[]  @relation("StockRequestTo")

  vendorInvoices VendorInvoice[]

  @@unique([tenantId, id])
  @@index([tenantId, locationId])
  @@map("warehouses")
}

/// An ingredient or good kept in stock, organization-wide. The unit is fixed once the item has movements.
model StockItem {
  id            String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  name          String
  sku           String?
  unit          StockUnit
  /// Reorder level; null = none.
  minQuantity   Decimal?           @map("min_quantity") @db.Decimal(14, 3)
  /// A variant's parent (ADR 0038): one level only, checked by the service.
  parentItemId  String?            @map("parent_item_id") @db.Uuid
  /// A variant's attribute values in attribute order; empty for other items.
  variantValues String[]           @default([]) @map("variant_values")
  /// Default unit price on sales orders (ADR 0044); null = none.
  salePrice     Decimal?           @map("sale_price") @db.Decimal(12, 2)
  /// Its category (ADR 0048); null = uncategorized.
  categoryId    String?            @map("category_id") @db.Uuid
  /// Brand and pack size (ADR 0055): e.g. 12 x 500 g; size and its unit come together.
  brand         String?
  packCount     Int?               @map("pack_count")
  packSize      Decimal?           @map("pack_size") @db.Decimal(14, 3)
  packUnit      StockUnit?         @map("pack_unit")
  archivedAt    DateTime?          @map("archived_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization  Organization       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parent        StockItem?         @relation("StockItemVariants", fields: [tenantId, parentItemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  category      ProductCategory?   @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  variants      StockItem[]        @relation("StockItemVariants")
  movements     StockMovement[]
  levels        StockLevel[]
  recipeLines   RecipeLine[]
  boms          Bom[]              @relation("BomOutput")
  bomLines      BomLine[]          @relation("BomComponent")
  salesLines    SalesOrderLine[]
  requestLines  StockRequestLine[]

  vendorInvoiceLines VendorInvoiceLine[]

  @@unique([tenantId, id])
  /// One variant per combination of values (NULL parents never collide).
  @@unique([tenantId, parentItemId, variantValues])
  @@index([tenantId, categoryId])
  @@map("stock_items")
}

/// A receipt, adjustment or transfer. Append-only; numbered per kind (ADR 0012).
model StockDocument {
  id              String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  number          String
  kind            StockDocumentKind
  warehouseId     String                 @map("warehouse_id") @db.Uuid
  /// Set exactly for transfers (stock_documents_transfer_check).
  toWarehouseId   String?                @map("to_warehouse_id") @db.Uuid
  /// Set exactly for adjustments (stock_documents_reason_check).
  reason          StockAdjustmentReason?
  supplier        String?
  note            String?
  /// The kitchen ticket a consumption was booked for (no FK: pos's table, ADR 0028).
  sourceTicketId  String?                @map("source_ticket_id") @db.Uuid
  /// The sales order an issue or restock was booked for (no FK: the orders module's table, ADR 0044).
  sourceOrderId   String?                @map("source_order_id") @db.Uuid
  /// The branch stock request a transfer or shortage was booked for (no FK: the orders module's table, ADR 0045).
  sourceRequestId String?                @map("source_request_id") @db.Uuid
  createdByUserId String                 @map("created_by_user_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  warehouse       Warehouse              @relation("StockDocumentWarehouse", fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  toWarehouse     Warehouse?             @relation("StockDocumentToWarehouse", fields: [tenantId, toWarehouseId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  movements       StockMovement[]

  vendorInvoice VendorInvoice?

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, sourceTicketId])
  @@index([tenantId, warehouseId, createdAt])
  @@index([tenantId, sourceOrderId])
  @@index([tenantId, sourceRequestId])
  @@map("stock_documents")
}

/// One line of the stock ledger: signed quantity at a unit cost. Append-only (CLAUDE.md rule 7).
model StockMovement {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  documentId   String        @map("document_id") @db.Uuid
  warehouseId  String        @map("warehouse_id") @db.Uuid
  itemId       String        @map("item_id") @db.Uuid
  quantity     Decimal       @db.Decimal(14, 3)
  unitCost     Decimal       @map("unit_cost") @db.Decimal(14, 4)
  value        Decimal       @db.Decimal(14, 2)
  /// The expiry date the goods came with (ADR 0062): given on receipts, carried along on transfers.
  expiresOn    DateTime?     @map("expires_on") @db.Date
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  document     StockDocument @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  warehouse    Warehouse     @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  item         StockItem     @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, documentId])
  @@index([tenantId, itemId, warehouseId])
  @@map("stock_movements")
}

/// Current quantity and weighted average cost per warehouse and item: the ledger's projection (ADR 0027 §4).
model StockLevel {
  tenantId     String       @map("tenant_id") @db.Uuid
  warehouseId  String       @map("warehouse_id") @db.Uuid
  itemId       String       @map("item_id") @db.Uuid
  quantity     Decimal      @db.Decimal(14, 3)
  averageCost  Decimal      @map("average_cost") @db.Decimal(14, 4)
  /// The earliest expiry date of what is in stock (ADR 0062); cleared when nothing is left.
  expiresOn    DateTime?    @map("expires_on") @db.Date
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  warehouse    Warehouse    @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  item         StockItem    @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, warehouseId, itemId])
  @@map("stock_levels")
}

/// One ingredient of a menu product: what one portion uses, in the item's unit (docs/modules/inventory.md → Recipes).
/// `productId` has no FK: catalog decides "sold" by FK violations on products (ADR 0024, 0028).
model RecipeLine {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  productId    String       @map("product_id") @db.Uuid
  itemId       String       @map("item_id") @db.Uuid
  quantity     Decimal      @db.Decimal(14, 3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  item         StockItem    @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, productId, itemId])
  @@map("recipe_lines")
}

/// A unit of measurement: `factor` of a base unit (Case = 24 pc, Sack = 25 kg). Receipts may be entered in it and are
/// converted to the item's unit. Archived, never deleted; the base unit never changes (ADR 0038).
model UnitOfMeasure {
  id                 String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  name               String
  symbol             String
  baseUnit           StockUnit           @map("base_unit")
  factor             Decimal             @db.Decimal(14, 6)
  archivedAt         DateTime?           @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  vendorInvoiceLines VendorInvoiceLine[]

  @@unique([tenantId, id])
  @@map("units_of_measure")
}

/// An attribute variants differ in, with its values in display order (Size: Small, Medium, Large). Archived, never
/// deleted; variants keep the values they were generated with (ADR 0038).
model VariantAttribute {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  name         String
  values       String[]
  archivedAt   DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@map("variant_attributes")
}

/// A bill of materials: what `outputQuantity` of a prepared stock item takes. Configuration: replaced as a whole,
/// deleted freely, audited (ADR 0038).
model Bom {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  itemId         String       @map("item_id") @db.Uuid
  outputQuantity Decimal      @map("output_quantity") @db.Decimal(14, 3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  item           StockItem    @relation("BomOutput", fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  lines          BomLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, itemId])
  @@map("boms")
}

/// One component of a bill of materials, in the component's unit.
model BomLine {
