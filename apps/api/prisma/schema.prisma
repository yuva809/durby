/// Price rules (docs/modules/catalog.md → Price rules, ADR 0030).
enum PriceRuleKind {
  fixed
  percent_off

  @@map("price_rule_kind")
}

/// A product's price at a location, or a happy hour on a category, on given days, hours and dates. Configuration:
/// changed and deleted freely, every change audited. Checks (target, value, hours, dates) are in the migration.
model PriceRule {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  name         String
  locationId   String?          @map("location_id") @db.Uuid
  productId    String?          @map("product_id") @db.Uuid
  categoryId   String?          @map("category_id") @db.Uuid
  kind         PriceRuleKind
  value        Decimal          @db.Decimal(12, 2)
  /// Weekdays (mon … sun); empty: every day.
  days         String[]         @default([])
  /// Local HH:mm.
  startsAt     String?          @map("starts_at")
  endsAt       String?          @map("ends_at")
  validFrom    DateTime?        @map("valid_from") @db.Date
  validUntil   DateTime?        @map("valid_until") @db.Date
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location     Location?        @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  product      Product?         @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  category     ProductCategory? @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, locationId])
  @@map("price_rules")
}

/// Remote printer commands (ADR 0032 §15): find printers or print a test page on a location's Android till.
/// Expires 5 minutes after it was requested (pos_printer_commands_expiry_check); claimed and finished in order
/// (pos_printer_commands_lifecycle_check). The app never deletes rows; the audit log is the lasting record.
model PosPrinterCommand {
  id                String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String                  @map("tenant_id") @db.Uuid
  locationId        String                  @map("location_id") @db.Uuid
  kind              PosPrinterCommandKind
  status            PosPrinterCommandStatus @default(pending)
  requestedByUserId String                  @map("requested_by_user_id") @db.Uuid
  claimedByUserId   String?                 @map("claimed_by_user_id") @db.Uuid
  /// Addresses and answer codes only (posPrinterCommandResultSchema).
  result            Json?
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt         DateTime                @map("expires_at") @db.Timestamptz(6)
  claimedAt         DateTime?               @map("claimed_at") @db.Timestamptz(6)
  completedAt       DateTime?               @map("completed_at") @db.Timestamptz(6)
  /// The printer a test print is for (ADR 0033); null for Find printer and for commands from before printers.
  printerId         String?                 @map("printer_id") @db.Uuid
  organization      Organization            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location          Location                @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  printer           PosPrinter?             @relation(fields: [tenantId, printerId], references: [tenantId, id], onDelete: NoAction, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, locationId, createdAt])
  @@map("pos_printer_commands")
}

/// A network printer at a location (ADR 0033): prints bills and/or the tickets of its stations. Archived, never
/// deleted; a new printer starts switched off. Address rules as ADR 0032 (CHECKs in the migration).
model PosPrinter {
  id           String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  locationId   String              @map("location_id") @db.Uuid
  /// Unique per location among printers that aren't archived (pos_printers_location_name_key, case-insensitive).
  name         String
  host         String
  port         Int
  widthDots    Int                 @map("width_dots")
  cutter       Boolean
  /// gsV0 or escStar (CHECK).
  imageMode    String              @map("image_mode")
  enabled      Boolean             @default(false)
  printsBills  Boolean             @default(false) @map("prints_bills")
  archivedAt   DateTime?           @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location     Location            @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  stations     PosPrinterStation[]
  commands     PosPrinterCommand[]

  printJobs PosPrintJob[]

  @@unique([tenantId, id])
  @@index([tenantId, locationId])
  @@map("pos_printers")
}

/// Which stations' tickets a printer prints (ADR 0033): many-to-many by station key, so "stations as a list" later
/// needs no printer changes (CHECK on today's keys until then).
model PosPrinterStation {
  tenantId   String     @map("tenant_id") @db.Uuid
  printerId  String     @map("printer_id") @db.Uuid
  stationKey String     @map("station_key")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  printer    PosPrinter @relation(fields: [tenantId, printerId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)

  @@id([tenantId, printerId, stationKey])
  @@index([tenantId, stationKey])
  @@map("pos_printer_stations")
}

enum PosPrinterCommandKind {
  find_printers
  test_print

  @@map("pos_printer_command_kind")
}

enum PosPrinterCommandStatus {
  pending
  claimed
  done
  failed

  @@map("pos_printer_command_status")
}

/// Print jobs (ADR 0033): one per ticket and printer (or per bill), claimed by a till with the app and printed there.
/// Never deleted; retried only when nothing can have printed. CHECKs and partial indexes in the migration.
model PosPrintJob {
  id                String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  locationId        String            @map("location_id") @db.Uuid
  printerId         String            @map("printer_id") @db.Uuid
  kind              PosPrintJobKind
  orderId           String            @map("order_id") @db.Uuid
  /// Set iff kind = ticket (CHECK).
  ticketId          String?           @map("ticket_id") @db.Uuid
  /// The guest check a bill job prints (ADR 0036); null: the job prints from the order (jobs from before checks).
  checkId           String?           @map("check_id") @db.Uuid
  status            PosPrintJobStatus @default(pending)
  attempts          Int               @default(0)
  /// The print object's last answer (print.*).
  lastCode          String?           @map("last_code")
  /// Not claimed before this instant: the wait before a retry.
  notBefore         DateTime          @default(now()) @map("not_before") @db.Timestamptz(6)
  /// Never printed by itself after this (setting pos.printJobMaxAgeSeconds when queued).
  expiresAt         DateTime          @map("expires_at") @db.Timestamptz(6)
  requestedByUserId String            @map("requested_by_user_id") @db.Uuid
  claimedByUserId   String?           @map("claimed_by_user_id") @db.Uuid
  claimedAt         DateTime?         @map("claimed_at") @db.Timestamptz(6)
  completedAt       DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location          Location          @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  printer           PosPrinter        @relation(fields: [tenantId, printerId], references: [tenantId, id], onDelete: NoAction, onUpdate: Restrict)
  order             PosOrder          @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: NoAction, onUpdate: Restrict)
  ticket            PosKitchenTicket? @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: NoAction, onUpdate: Restrict)
  check             PosGuestCheck?    @relation(fields: [tenantId, checkId], references: [tenantId, id], onDelete: NoAction, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, orderId])
  @@index([tenantId, checkId])
  @@map("pos_print_jobs")
}

enum PosPrintJobKind {
  ticket
  bill

  @@map("pos_print_job_kind")
}

enum PosPrintJobStatus {
  pending
  claimed
  printed
  failed
  needs_check

  @@map("pos_print_job_status")
}

enum SalesOrderStatus {
  draft
  confirmed
  picking
  packed
  dispatched
  delivered
  returned
  cancelled

  @@map("sales_order_status")
}

/// A customer of a distribution business (ADR 0044). Archived, never deleted: orders keep pointing at it.
model OrderCustomer {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  name         String
  /// The business's own reference; unique among active customers (partial index).
  code         String?
  phone        String?
  email        String?
  address      String?
  note         String?
  archivedAt   DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  orders       SalesOrder[]

  @@unique([tenantId, id])
  @@map("order_customers")
}

/// A sales order: stock items for a customer, leaving from one warehouse (ADR 0044). Numbered (SO-…, ADR 0012).
model SalesOrder {
  id              String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  number          String
  status          SalesOrderStatus  @default(draft)
  customerId      String            @map("customer_id") @db.Uuid
  /// The warehouse's location, kept for access checks and filters.
  locationId      String            @map("location_id") @db.Uuid
  warehouseId     String            @map("warehouse_id") @db.Uuid
  requestedDate   DateTime?         @map("requested_date") @db.Date
  deliveryAddress String?           @map("delivery_address")
  note            String?
  /// Sum of the line totals (exact cents).
  total           Decimal           @db.Decimal(14, 2)
  createdByUserId String            @map("created_by_user_id") @db.Uuid
  /// Delivery details (step 3); personal data, never in audit snapshots.
  driverName      String?           @map("driver_name")
  driverPhone     String?           @map("driver_phone")
  vehicle         String?
  dispatchedAt    DateTime?         @map("dispatched_at") @db.Timestamptz(6)
  deliveredAt     DateTime?         @map("delivered_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer        OrderCustomer     @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  location        Location          @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  warehouse       Warehouse         @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  lines           SalesOrderLine[]
  events          SalesOrderEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, locationId, id])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("sales_orders")
}

/// One item of a sales order. Replaced as a whole while the order is a draft.
model SalesOrderLine {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  itemId         String       @map("item_id") @db.Uuid
  quantity       Decimal      @db.Decimal(14, 3)
  unitPrice      Decimal      @map("unit_price") @db.Decimal(12, 2)
  lineTotal      Decimal      @map("line_total") @db.Decimal(14, 2)
  sortOrder      Int          @default(0) @map("sort_order")
  /// What was picked; null until the order is picked (step 3).
  pickedQuantity Decimal?     @map("picked_quantity") @db.Decimal(14, 3)
  organization   Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order          SalesOrder   @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  item           StockItem    @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, orderId, itemId])
  @@map("sales_order_lines")
}

/// The timeline of a sales order: one row per status it reached. Append-only.
model SalesOrderEvent {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  orderId      String           @map("order_id") @db.Uuid
  status       SalesOrderStatus
  note         String?
  userId       String?          @map("user_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order        SalesOrder       @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, orderId, id])
  @@map("sales_order_events")
}

enum FeedbackCategory {
  bug
  idea
  question

  @@map("feedback_category")
}

enum FeedbackStatus {
  new
  seen
  done

  @@map("feedback_status")
}

/// Feedback to the Durby team (ADR 0044 step 5). Platform data, not tenant data: no tenantId, no RLS; the app inserts an
/// organization's feedback and reads it back filtered by the session's organization; the admin portal reads all.
model Feedback {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
