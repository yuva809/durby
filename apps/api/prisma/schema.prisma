// Durby database schema. Tables: snake_case plural via @@map; models: PascalCase singular.
// Connection URL lives in prisma.config.ts (MIGRATION_DATABASE_URL, runs as durby_migrator).

generator client {
  provider     = "prisma-client"
  output       = "../src/platform/database/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy (docs/platform/tenancy.md, ADR 0005)
// Platform tables (no RLS): partners, organizations.
// Tenant tables (RLS): carry tenant_id, UNIQUE (tenant_id, id), composite FKs.
// ---------------------------------------------------------------------------

model Partner {
  id             String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug           String                 @unique
  name           String
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  organizations  Organization[]
  settingValues  PartnerSettingValue[]
  labelOverrides PartnerLabelOverride[]

  @@map("partners")
}

/// The tenant. No RLS: holds non-sensitive platform fields only (ADR 0005).
model Organization {
  id                  String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  partnerId           String                  @map("partner_id") @db.Uuid
  name                String
  /// Nullable until a later step (expand/contract, ADR 0004/0009): no plan = nothing enabled.
  planId              String?                 @map("plan_id") @db.Uuid
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  partner             Partner                 @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  plan                Plan?                   @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  brands              Brand[]
  locations           Location[]
  memberships         Membership[]
  lastUsedBy          User[]
  refreshTokens       RefreshToken[]
  roles               Role[]
  rolePermissions     RolePermission[]
  membershipLocations MembershipLocation[]
  invitations         Invitation[]
  invitationLocations InvitationLocation[]
  auditLogs           AuditLog[]
  featureOverrides    TenantFeatureOverride[]
  settingValues       SettingValue[]
  labelOverrides      LabelOverride[]

  @@index([partnerId])
  @@index([planId])
  @@map("organizations")
}

model Brand {
  id            String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  name          String
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization  Organization   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  locations     Location[]
  settingValues SettingValue[]

  @@unique([tenantId, id])
  @@map("brands")
}

model Location {
  id            String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  brandId       String               @map("brand_id") @db.Uuid
  name          String
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization  Organization         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  brand         Brand                @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  memberships   MembershipLocation[]
  invitations   InvitationLocation[]
  settingValues SettingValue[]

  @@unique([tenantId, id])
  @@index([tenantId, brandId])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// Authentication (docs/platform/auth.md, ADR 0006)
// Platform tables, private to platform/auth (the platform client refuses them):
// users, user_tokens, refresh_tokens. Tenant table (RLS): memberships.
// ---------------------------------------------------------------------------

/// A back-office user, once across all organizations. Email is stored normalized (trimmed, lower-case).
model User {
  id                  String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email               String         @unique
  /// argon2id. Null until the first password reset (bootstrap admins, invites).
  passwordHash        String?        @map("password_hash")
  emailVerifiedAt     DateTime?      @map("email_verified_at") @db.Timestamptz(6)
  locale              String         @default("en")
  lastOrganizationId  String?        @map("last_organization_id") @db.Uuid
  passwordChangedAt   DateTime?      @map("password_changed_at") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastOrganization    Organization?  @relation(fields: [lastOrganizationId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  tokens              UserToken[]
  refreshTokens       RefreshToken[]
  memberships         Membership[]
  invitationsSent     Invitation[]   @relation("InvitationInvitedBy")
  invitationsAccepted Invitation[]   @relation("InvitationAcceptedBy")

  @@map("users")
}

enum UserTokenPurpose {
  email_verification
  password_reset

  @@map("user_token_purpose")
}

/// Email verification and password reset tokens: sha256 of 32 random bytes, single-use, short-lived.
model UserToken {
  id        String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   UserTokenPurpose
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId, purpose])
  @@map("user_tokens")
}

enum RefreshTokenRevokeReason {
  logout
  reuse_detected
  password_reset

  @@map("refresh_token_revoke_reason")
}

/// Rotating refresh tokens (sha256). A family is one login session; reuse of a used token revokes the family.
model RefreshToken {
  id              String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String                    @map("user_id") @db.Uuid
  familyId        String                    @map("family_id") @db.Uuid
  tokenHash       String                    @unique @map("token_hash")
  /// Active organization of the session. Not a tenant key: membership is re-checked on every refresh.
  organizationId  String?                   @map("organization_id") @db.Uuid
  expiresAt       DateTime                  @map("expires_at") @db.Timestamptz(6)
  familyExpiresAt DateTime                  @map("family_expires_at") @db.Timestamptz(6)
  usedAt          DateTime?                 @map("used_at") @db.Timestamptz(6)
  revokedAt       DateTime?                 @map("revoked_at") @db.Timestamptz(6)
  revokedReason   RefreshTokenRevokeReason? @map("revoked_reason")
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  organization    Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

/// User ↔ organization with a role and optional location scope. Tenant table (RLS).
model Membership {
  id           String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  /// Nullable until a later step (expand/contract, ADR 0004): a membership without a role has no permissions.
  roleId       String?              @map("role_id") @db.Uuid
  /// false: limited to the membership_locations rows (none = no locations).
  allLocations Boolean              @default(true) @map("all_locations")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role         Role?                @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  locations    MembershipLocation[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, roleId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// RBAC (docs/platform/rbac.md, ADR 0007). Tenant tables (RLS): roles, role_permissions,
// membership_locations, invitations, invitation_locations.
// ---------------------------------------------------------------------------

enum SystemRole {
  owner
  admin
  manager
  staff

  @@map("system_role")
}

/// A system role (system_key set, permissions defined in code) or a custom role (name set, role_permissions rows).
model Role {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  systemKey    SystemRole?      @map("system_key")
  name         String?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permissions  RolePermission[]
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([tenantId, id])
  @@unique([tenantId, systemKey])
  @@unique([tenantId, name])
  @@map("roles")
}

/// Permission keys of a custom role. Keys are validated against the registry by the API.
model RolePermission {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  roleId        String       @map("role_id") @db.Uuid
  permissionKey String       @map("permission_key")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization  Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role          Role         @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, roleId, permissionKey])
  @@map("role_permissions")
}

model MembershipLocation {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  membershipId String       @map("membership_id") @db.Uuid
  locationId   String       @map("location_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership   Membership   @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  /// Restrict: deleting a location must never widen a location-limited membership.
  location     Location     @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, membershipId, locationId])
  @@index([tenantId, locationId])
  @@map("membership_locations")
}

/// An invitation by email. Token: `<orgId>.<secret>`, stored as sha256(secret), single-use, 7 days.
model Invitation {
  id               String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  /// Normalized (trimmed, lower-case).
  email            String
  roleId           String               @map("role_id") @db.Uuid
  allLocations     Boolean              @default(true) @map("all_locations")
  invitedByUserId  String               @map("invited_by_user_id") @db.Uuid
  tokenHash        String               @unique @map("token_hash")
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?            @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId String?              @map("accepted_by_user_id") @db.Uuid
  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role             Role                 @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  invitedBy        User                 @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  acceptedBy       User?                @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  locations        InvitationLocation[]

  @@unique([tenantId, id])
  @@index([tenantId, email])
  @@index([tenantId, roleId])
  @@map("invitations")
}

model InvitationLocation {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  invitationId String       @map("invitation_id") @db.Uuid
  locationId   String       @map("location_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invitation   Invitation   @relation(fields: [tenantId, invitationId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  location     Location     @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, invitationId, locationId])
  @@map("invitation_locations")
}

// ---------------------------------------------------------------------------
// Audit (docs/platform/audit.md, ADR 0008)
// Append-only: UPDATE/DELETE/TRUNCATE revoked from durby_app and blocked by a statement trigger.
// ---------------------------------------------------------------------------

enum AuditActorType {
  user
  system

  @@map("audit_actor_type")
}

/// One row per state-changing action, written in the change's transaction. Never updated or deleted.
model AuditLog {
  id           String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  actorType    AuditActorType @map("actor_type")
  /// Set iff actor_type = user. No FK: rows outlive users.
  actorUserId  String?        @map("actor_user_id") @db.Uuid
  /// Set iff actor_type = system; a key of AUDIT_SYSTEM_ACTORS.
  actorSystem  String?        @map("actor_system")
  /// A key of AUDIT_ACTIONS.
  action       String
  entityType   String         @map("entity_type")
  /// No FK: the entity may be deleted later.
  entityId     String         @map("entity_id") @db.Uuid
  /// Allow-listed snapshot (ADR 0008 §5).
  before       Json?
  after        Json?
  requestId    String?        @map("request_id")
  /// Personal data; retention open before production (ADR 0008 §10).
  ip           String?        @db.Inet
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId, id])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Entitlements (docs/platform/entitlements.md, ADR 0009)
// Platform reference tables, read-only for durby_app (contents change only through migrations):
// plans, plan_features. Tenant table (RLS): tenant_feature_overrides.
// ---------------------------------------------------------------------------

model Plan {
  id            String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Stable; users see the label `platform.plans.<key>`.
  key           String         @unique
  /// Operator name (CLI output).
  name          String
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  features      PlanFeature[]
  organizations Organization[]

  @@map("plans")
}

/// The plan includes the feature. Key and limits are validated against the registry by the api.
model PlanFeature {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  planId     String   @map("plan_id") @db.Uuid
  featureKey String   @map("feature_key")
  /// Strict per-feature schema in packages/shared; absent limit = unlimited.
  limits     Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([planId, featureKey])
  @@map("plan_features")
}

/// Enables or disables one feature for one organization, whatever its plan says. Audited.
model TenantFeatureOverride {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  featureKey   String       @map("feature_key")
  enabled      Boolean
  /// Only with enabled = true (CHECK). Per-limit override of the plan's limits.
  limits       Json?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, featureKey])
  @@map("tenant_feature_overrides")
}

// ---------------------------------------------------------------------------
// Settings (docs/platform/settings.md, ADR 0010)
// Platform table, read-only for durby_app (values change only through migrations):
// partner_setting_values. Tenant table (RLS): setting_values.
// ---------------------------------------------------------------------------

enum SettingScopeType {
  organization
  brand
  location

  @@map("setting_scope_type")
}

/// A partner-level default. Key and value are validated against the registry by the api.
model PartnerSettingValue {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  partnerId String   @map("partner_id") @db.Uuid
  key       String
  /// Never JSON null (CHECK).
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([partnerId, key])
  @@map("partner_setting_values")
}

/// One value of one setting at one organization, brand or location scope. Audited.
model SettingValue {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  scopeType    SettingScopeType @map("scope_type")
  /// Set iff scope_type = brand (CHECK).
  brandId      String?          @map("brand_id") @db.Uuid
  /// Set iff scope_type = location (CHECK).
  locationId   String?          @map("location_id") @db.Uuid
  key          String
  /// Never JSON null (CHECK): delete the row to inherit.
  value        Json
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  brand        Brand?           @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  location     Location?        @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  /// NULLS NOT DISTINCT in the migration: one value per key and scope.
  @@unique([tenantId, scopeType, brandId, locationId, key], map: "setting_values_scope_key_key")
  @@index([tenantId, brandId])
  @@index([tenantId, locationId])
  @@map("setting_values")
}

/// A partner's label text (ADR 0011). Read-only for the app: changed only by reviewed migrations.
/// Key, locale and placeholders are validated against packages/i18n by the api.
model PartnerLabelOverride {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  partnerId String   @map("partner_id") @db.Uuid
  locale    String
  key       String
  /// 1–1000 characters (CHECK).
  value     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([partnerId, locale, key])
  @@map("partner_label_overrides")
}

/// An organization's label text for one org-overridable key in one locale (ADR 0011). Audited.
model LabelOverride {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  locale       String
  key          String
  /// 1–200 characters, one line (CHECK).
  value        String
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, locale, key])
  @@map("label_overrides")
}
