// Durby database schema. Tables: snake_case plural via @@map; models: PascalCase singular.
// Connection URL lives in prisma.config.ts (MIGRATION_DATABASE_URL, runs as durby_migrator).

generator client {
  provider     = "prisma-client"
  output       = "../src/platform/database/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy (docs/platform/tenancy.md, ADR 0005)
// Platform tables (no RLS): partners, organizations.
// Tenant tables (RLS): carry tenant_id, UNIQUE (tenant_id, id), composite FKs.
// ---------------------------------------------------------------------------

model Partner {
  id             String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug           String                 @unique
  name           String
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  organizations  Organization[]
  settingValues  PartnerSettingValue[]
  labelOverrides PartnerLabelOverride[]
  theme          PartnerTheme?
  domains        PartnerDomain[]

  @@map("partners")
}

// ---------------------------------------------------------------------------
// Partner theming (docs/platform/web-shell.md, ADR 0015)
// Platform tables (no RLS), read-only for the app: changed only through reviewed migrations.
// ---------------------------------------------------------------------------

/// A partner's white-label theme. Without a row the partner uses the default theme (DEFAULT_THEME).
model PartnerTheme {
  partnerId    String   @id @map("partner_id") @db.Uuid
  /// 1–60 characters, no control characters (CHECK).
  productName  String   @map("product_name")
  /// Static file under apps/web/public/brand/<slug>/ (CHECK); null = text wordmark.
  logoPath     String?  @map("logo_path")
  /// `#rrggbb`, lowercase (CHECK). Ink and paper: null = default.
  colorPrimary String   @map("color_primary")
  colorInk     String?  @map("color_ink")
  colorPaper   String?  @map("color_paper")
  /// Sidebar layout (ADR 0044): `default` or `operations` (CHECK).
  navLayout    String   @default("default") @map("nav_layout")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  partner      Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("partner_themes")
}

/// A hostname that serves a partner's theme. Lowercase DNS name without port (CHECK).
model PartnerDomain {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  partnerId String   @map("partner_id") @db.Uuid
  hostname  String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([partnerId])
  @@map("partner_domains")
}

/// The tenant. No RLS: holds non-sensitive platform fields only (ADR 0005).
model Organization {
  vendorInvoiceLineCorrections VendorInvoiceLineCorrection[]
  id                           String                        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  partnerId                    String                        @map("partner_id") @db.Uuid
  name                         String
  /// NOT NULL since step 1.11 (contract step, ADR 0004/0009).
  planId                       String                        @map("plan_id") @db.Uuid
  createdAt                    DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  partner                      Partner                       @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  plan                         Plan                          @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  brands                       Brand[]
  locations                    Location[]
  memberships                  Membership[]
  lastUsedBy                   User[]
  refreshTokens                RefreshToken[]
  roles                        Role[]
  rolePermissions              RolePermission[]
  membershipLocations          MembershipLocation[]
  membershipPermissions        MembershipPermission[]
  invitationPermissions        InvitationPermission[]
  vouchedUsers                 User[]                        @relation("UserVouchedBy")
  invitations                  Invitation[]
  invitationLocations          InvitationLocation[]
  auditLogs                    AuditLog[]
  featureOverrides             TenantFeatureOverride[]
  settingValues                SettingValue[]
  labelOverrides               LabelOverride[]
  numberSeries                 NumberSeries[]
  numberSeriesCounters         NumberSeriesCounter[]
  outboxEvents                 OutboxEvent[]
  processedEvents              ProcessedEvent[]
  idempotencyKeys              IdempotencyKey[]
  productCategories            ProductCategory[]
  products                     Product[]
  diningTables                 DiningTable[]
  posOrders                    PosOrder[]
  posKitchenTickets            PosKitchenTicket[]
  posTicketStatusChanges       PosTicketStatusChange[]
  warehouses                   Warehouse[]
  stockItems                   StockItem[]
  stockDocuments               StockDocument[]
  stockMovements               StockMovement[]
  stockLevels                  StockLevel[]
  recipeLines                  RecipeLine[]
  unitsOfMeasure               UnitOfMeasure[]
  variantAttributes            VariantAttribute[]
  boms                         Bom[]
  bomLines                     BomLine[]
  posOrderLines                PosOrderLine[]
  posBills                     PosBill[]
  posBillOrders                PosBillOrder[]
  posBillItems                 PosBillItem[]
  posGuestChecks               PosGuestCheck[]
  posGuestCheckShares          PosGuestCheckShare[]
  posBillCancellations         PosBillCancellation[]
  posOrderDiscounts            PosOrderDiscount[]
  posTicketPlacements          PosTicketPlacement[]
  productImages                ProductImage[]
  posOrderDiscountLines        PosOrderDiscountLine[]
  diningAreas                  DiningArea[]
  posFloorPlanVersions         PosFloorPlanVersion[]
  posFloorPlanPublications     PosFloorPlanPublication[]
  reservationTableRules        ReservationTableRule[]
  reservationCombinations      ReservationCombination[]
  reservationCombinationTables ReservationCombinationTable[]
  reservationGuests            ReservationGuest[]
  reservations                 Reservation[]
  waitlistEntries              WaitlistEntry[]
  reservationBookingPages      ReservationBookingPage[]
  reservationTables            ReservationTable[]
  reservationStatusChanges     ReservationStatusChange[]
  productCategoryImages        ProductCategoryImage[]
  priceRules                   PriceRule[]
  posPrinterCommands           PosPrinterCommand[]
  posPrinters                  PosPrinter[]
  posPrintJobs                 PosPrintJob[]
  orderCustomers               OrderCustomer[]
  salesOrders                  SalesOrder[]
  salesOrderLines              SalesOrderLine[]
  salesOrderEvents             SalesOrderEvent[]
  feedback                     Feedback[]
  stockRequests                StockRequest[]
  stockRequestLines            StockRequestLine[]
  stockRequestEvents           StockRequestEvent[]
  notifications                Notification[]
  notificationPreferences      NotificationPreference[]
  pushSubscriptions            PushSubscription[]

  vendorInvoices         VendorInvoice[]
  vendorInvoiceLines     VendorInvoiceLine[]
  reportOrderFacts       ReportOrderFact[]
  reportLineFacts        ReportLineFact[]
  reportReservationFacts ReportReservationFact[]
  reportDailyMessages    ReportDailyMessage[]

  @@index([partnerId])
  @@index([planId])
  @@map("organizations")
}

model Brand {
  id            String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  name          String
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization  Organization   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  locations     Location[]
  settingValues SettingValue[]

  @@unique([tenantId, id])
  @@map("brands")
}

model Location {
  id                      String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId                String                   @map("tenant_id") @db.Uuid
  brandId                 String                   @map("brand_id") @db.Uuid
  name                    String
  /// The branch's address (ADR 0056); null = none.
  address                 String?
  /// Archived (ADR 0056): hidden from lists and pickers, its data kept.
  archivedAt              DateTime?                @map("archived_at") @db.Timestamptz(6)
  /// A warehouse's own place (ADR 0068), not a branch.
  isWarehouseSite         Boolean                  @default(false) @map("is_warehouse_site")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization            Organization             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  brand                   Brand                    @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  memberships             MembershipLocation[]
  invitations             InvitationLocation[]
  settingValues           SettingValue[]
  diningTables            DiningTable[]
  posOrders               PosOrder[]
  posBills                PosBill[]
  diningAreas             DiningArea[]
  posFloorPlanVersions    PosFloorPlanVersion[]
  reservationCombinations ReservationCombination[]
  reservations            Reservation[]
  waitlistEntries         WaitlistEntry[]
  reservationBookingPages ReservationBookingPage[]
  warehouses              Warehouse[]
  priceRules              PriceRule[]
  posPrinterCommands      PosPrinterCommand[]
  posPrinters             PosPrinter[]
  posPrintJobs            PosPrintJob[]
  salesOrders             SalesOrder[]
  stockRequests           StockRequest[]
  reportOrderFacts        ReportOrderFact[]
  reportLineFacts         ReportLineFact[]
  reportReservationFacts  ReportReservationFact[]

  @@unique([tenantId, id])
  @@index([tenantId, brandId])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// Authentication (docs/platform/auth.md, ADR 0006)
// Platform tables, private to platform/auth (the platform client refuses them):
// users, user_tokens, refresh_tokens. Tenant table (RLS): memberships.
// ---------------------------------------------------------------------------

/// A back-office user, once across all organizations. Email is stored normalized (trimmed, lower-case).
model User {
  id                      String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email                   String           @unique
  /// argon2id. Null until the first password reset (bootstrap admins, invites).
  passwordHash            String?          @map("password_hash")
  emailVerifiedAt         DateTime?        @map("email_verified_at") @db.Timestamptz(6)
  locale                  String           @default("en")
  lastOrganizationId      String?          @map("last_organization_id") @db.Uuid
  passwordChangedAt       DateTime?        @map("password_changed_at") @db.Timestamptz(6)
  /// Set when an organization created the account with a temporary password (ADR 0023 §3): every session
  /// is limited to changing it until it is changed.
  mustChangePassword      Boolean          @default(false) @map("must_change_password")
  /// The organization that created the account with a temporary password: it may sign in before the email
  /// is verified (ADR 0023 §3). Nothing else treats the email as verified.
  vouchedByOrganizationId String?          @map("vouched_by_organization_id") @db.Uuid
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastOrganization        Organization?    @relation(fields: [lastOrganizationId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  vouchedBy               Organization?    @relation("UserVouchedBy", fields: [vouchedByOrganizationId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  tokens                  UserToken[]
  refreshTokens           RefreshToken[]
  memberships             Membership[]
  invitationsSent         Invitation[]     @relation("InvitationInvitedBy")
  invitationsAccepted     Invitation[]     @relation("InvitationAcceptedBy")
  idempotencyKeys         IdempotencyKey[]

  @@map("users")
}

enum UserTokenPurpose {
  email_verification
  password_reset

  @@map("user_token_purpose")
}

/// Email verification and password reset tokens: sha256 of 32 random bytes, single-use, short-lived.
model UserToken {
  id        String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   UserTokenPurpose
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId, purpose])
  @@map("user_tokens")
}

enum RefreshTokenRevokeReason {
  logout
  reuse_detected
  password_reset
  /// A sibling issued from the same parent was used (ADR 0006 amendment: lost responses).
  superseded

  @@map("refresh_token_revoke_reason")
}

/// Rotating refresh tokens (sha256). A family is one login session; reuse of a used token revokes the family.
model RefreshToken {
  id              String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String                    @map("user_id") @db.Uuid
  familyId        String                    @map("family_id") @db.Uuid
  tokenHash       String                    @unique @map("token_hash")
  /// The token this one was issued from (null: login). Siblings exist only after a recovered lost response.
  parentId        String?                   @map("parent_id") @db.Uuid
  /// Active organization of the session. Not a tenant key: membership is re-checked on every refresh.
  organizationId  String?                   @map("organization_id") @db.Uuid
  expiresAt       DateTime                  @map("expires_at") @db.Timestamptz(6)
  familyExpiresAt DateTime                  @map("family_expires_at") @db.Timestamptz(6)
  usedAt          DateTime?                 @map("used_at") @db.Timestamptz(6)
  revokedAt       DateTime?                 @map("revoked_at") @db.Timestamptz(6)
  revokedReason   RefreshTokenRevokeReason? @map("revoked_reason")
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  organization    Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  parent   RefreshToken?  @relation("RefreshTokenParent", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  children RefreshToken[] @relation("RefreshTokenParent")

  @@index([familyId])
  @@index([userId])
  @@index([parentId])
  @@map("refresh_tokens")
}

/// User ↔ organization with a role and optional location scope. Tenant table (RLS).
model Membership {
  id            String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  userId        String                 @map("user_id") @db.Uuid
  /// NOT NULL since step 1.11 (contract step, ADR 0004/0007).
  roleId        String                 @map("role_id") @db.Uuid
  /// false: limited to the membership_locations rows (none = no locations).
  allLocations  Boolean                @default(true) @map("all_locations")
  /// The warehouses the member may work in (ADR 0057); empty = every warehouse at their locations. Checked by the
  /// service (an array has no foreign key; warehouses are archived, never deleted).
  warehouseIds  String[]               @default([]) @map("warehouse_ids") @db.Uuid
  /// The person's name and phone in this organization (ADR 0023 §7).
  displayName   String?                @map("display_name")
  phone         String?
  /// Set while the member is switched off: no access, the membership stays (ADR 0023 §6).
  deactivatedAt DateTime?              @map("deactivated_at") @db.Timestamptz(6)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization  Organization           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user          User                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role          Role                   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  locations     MembershipLocation[]
  permissions   MembershipPermission[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, roleId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// RBAC (docs/platform/rbac.md, ADR 0007). Tenant tables (RLS): roles, role_permissions,
// membership_locations, invitations, invitation_locations.
// ---------------------------------------------------------------------------

enum SystemRole {
  owner
  admin
  manager
  staff
  waiter
  cashier
  host
  kitchen
  bar
  branch
  warehouse
  driver

  @@map("system_role")
}

/// A system role (system_key set, permissions defined in code) or a custom role (name set, role_permissions rows).
model Role {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  systemKey    SystemRole?      @map("system_key")
  name         String?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permissions  RolePermission[]
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([tenantId, id])
  @@unique([tenantId, systemKey])
  @@unique([tenantId, name])
  @@map("roles")
}

/// Permission keys of a custom role. Keys are validated against the registry by the API.
model RolePermission {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  roleId        String       @map("role_id") @db.Uuid
  permissionKey String       @map("permission_key")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization  Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role          Role         @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, roleId, permissionKey])
  @@map("role_permissions")
}

model MembershipLocation {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  membershipId String       @map("membership_id") @db.Uuid
  locationId   String       @map("location_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership   Membership   @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  /// Restrict: deleting a location must never widen a location-limited membership.
  location     Location     @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, membershipId, locationId])
  @@index([tenantId, locationId])
  @@map("membership_locations")
}

/// grant: on top of the role; deny: taken away from the role (ADR 0023 §1).
enum PermissionEffect {
  grant
  deny

  @@map("permission_effect")
}

/// Per-member changes to the role's permissions (ADR 0023 §1).
model MembershipPermission {
  id            String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  membershipId  String           @map("membership_id") @db.Uuid
  permissionKey String           @map("permission_key")
  effect        PermissionEffect
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization  Organization     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership    Membership       @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, membershipId, permissionKey])
  @@map("membership_permissions")
}

/// An invitation by email. Token: `<orgId>.<secret>`, stored as sha256(secret), single-use, 7 days.
model Invitation {
  id               String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String                 @map("tenant_id") @db.Uuid
  /// Normalized (trimmed, lower-case).
  email            String
  roleId           String                 @map("role_id") @db.Uuid
  allLocations     Boolean                @default(true) @map("all_locations")
  invitedByUserId  String                 @map("invited_by_user_id") @db.Uuid
  tokenHash        String                 @unique @map("token_hash")
  expiresAt        DateTime               @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?              @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId String?                @map("accepted_by_user_id") @db.Uuid
  revokedAt        DateTime?              @map("revoked_at") @db.Timestamptz(6)
  /// Applied to the membership on accept (ADR 0023 §7).
  displayName      String?                @map("display_name")
  phone            String?
  /// The new staff member's language, chosen by the inviter (en | de); null on older invitations.
  locale           String?
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role             Role                   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  invitedBy        User                   @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  acceptedBy       User?                  @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  locations        InvitationLocation[]
  permissions      InvitationPermission[]

  @@unique([tenantId, id])
  @@index([tenantId, email])
  @@index([tenantId, roleId])
  @@map("invitations")
}

model InvitationLocation {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  invitationId String       @map("invitation_id") @db.Uuid
  locationId   String       @map("location_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invitation   Invitation   @relation(fields: [tenantId, invitationId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  location     Location     @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, invitationId, locationId])
  @@map("invitation_locations")
}

/// The per-member changes an invitation applies on accept (ADR 0023 §7).
model InvitationPermission {
  id            String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  invitationId  String           @map("invitation_id") @db.Uuid
  permissionKey String           @map("permission_key")
  effect        PermissionEffect
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization  Organization     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invitation    Invitation       @relation(fields: [tenantId, invitationId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, invitationId, permissionKey])
  @@map("invitation_permissions")
}

// ---------------------------------------------------------------------------
// Audit (docs/platform/audit.md, ADR 0008)
// Append-only: UPDATE/DELETE/TRUNCATE revoked from durby_app and blocked by a statement trigger.
// ---------------------------------------------------------------------------

enum AuditActorType {
  user
  system

  @@map("audit_actor_type")
}

/// One row per state-changing action, written in the change's transaction. Never updated or deleted.
model AuditLog {
  id           String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  actorType    AuditActorType @map("actor_type")
  /// Set iff actor_type = user. No FK: rows outlive users.
  actorUserId  String?        @map("actor_user_id") @db.Uuid
  /// Set iff actor_type = system; a key of AUDIT_SYSTEM_ACTORS.
  actorSystem  String?        @map("actor_system")
  /// A key of AUDIT_ACTIONS.
  action       String
  entityType   String         @map("entity_type")
  /// No FK: the entity may be deleted later.
  entityId     String         @map("entity_id") @db.Uuid
  /// Allow-listed snapshot (ADR 0008 §5).
  before       Json?
  after        Json?
  requestId    String?        @map("request_id")
  /// Personal data; retention open before production (ADR 0008 §10).
  ip           String?        @db.Inet
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId, id])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Entitlements (docs/platform/entitlements.md, ADR 0009)
// Platform reference tables, read-only for durby_app (contents change only through migrations):
// plans, plan_features. Tenant table (RLS): tenant_feature_overrides.
// ---------------------------------------------------------------------------

model Plan {
  id            String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Stable; users see the label `platform.plans.<key>`.
  key           String         @unique
  /// Operator name (CLI output).
  name          String
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  features      PlanFeature[]
  organizations Organization[]

  @@map("plans")
}

/// The plan includes the feature. Key and limits are validated against the registry by the api.
model PlanFeature {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  planId     String   @map("plan_id") @db.Uuid
  featureKey String   @map("feature_key")
  /// Strict per-feature schema in packages/shared; absent limit = unlimited.
  limits     Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([planId, featureKey])
  @@map("plan_features")
}

/// Enables or disables one feature for one organization, whatever its plan says. Audited.
model TenantFeatureOverride {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  featureKey   String        @map("feature_key")
  enabled      Boolean
  /// Only with enabled = true (CHECK). Per-limit override of the plan's limits.
  limits       Json?
  /// Why it was set, 1–500 characters (tenant_feature_overrides_reason_check). Admin portal 1d.
  reason       String?
  /// From then on the override counts as absent and the plan applies (end of a day in Europe/Berlin).
  expiresAt    DateTime?     @map("expires_at") @db.Timestamptz(6)
  /// The staff member who set it last; null for CLI and migration writes.
  setByStaffId String?       @map("set_by_staff_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  setBy        StaffAccount? @relation(fields: [setByStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, featureKey])
  @@map("tenant_feature_overrides")
}

// ---------------------------------------------------------------------------
// Settings (docs/platform/settings.md, ADR 0010)
// Platform table, read-only for durby_app (values change only through migrations):
// partner_setting_values. Tenant table (RLS): setting_values.
// ---------------------------------------------------------------------------

enum SettingScopeType {
  organization
  brand
  location

  @@map("setting_scope_type")
}

/// A partner-level default. Key and value are validated against the registry by the api.
model PartnerSettingValue {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  partnerId String   @map("partner_id") @db.Uuid
  key       String
  /// Never JSON null (CHECK).
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([partnerId, key])
  @@map("partner_setting_values")
}

/// One value of one setting at one organization, brand or location scope. Audited.
model SettingValue {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  scopeType    SettingScopeType @map("scope_type")
  /// Set iff scope_type = brand (CHECK).
  brandId      String?          @map("brand_id") @db.Uuid
  /// Set iff scope_type = location (CHECK).
  locationId   String?          @map("location_id") @db.Uuid
  key          String
  /// Never JSON null (CHECK): delete the row to inherit.
  value        Json
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  brand        Brand?           @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  location     Location?        @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  /// NULLS NOT DISTINCT in the migration: one value per key and scope.
  @@unique([tenantId, scopeType, brandId, locationId, key], map: "setting_values_scope_key_key")
  @@index([tenantId, brandId])
  @@index([tenantId, locationId])
  @@map("setting_values")
}

/// A partner's label text (ADR 0011). Read-only for the app: changed only by reviewed migrations.
/// Key, locale and placeholders are validated against packages/i18n by the api.
model PartnerLabelOverride {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  partnerId String   @map("partner_id") @db.Uuid
  locale    String
  key       String
  /// 1–1000 characters (CHECK).
  value     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([partnerId, locale, key])
  @@map("partner_label_overrides")
}

/// An organization's label text for one org-overridable key in one locale (ADR 0011). Audited.
model LabelOverride {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  locale       String
  key          String
  /// 1–200 characters, one line (CHECK).
  value        String
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, locale, key])
  @@map("label_overrides")
}

// ---------------------------------------------------------------------------
// Number series (ADR 0012)
// ---------------------------------------------------------------------------

enum NumberSeriesResetPolicy {
  yearly
  never

  @@map("number_series_reset_policy")
}

/// An organization's definition of a registry series. Never deleted (DELETE revoked); a trigger
/// keeps tenant_id and key fixed and the reset policy once a number was issued.
model NumberSeries {
  id           String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String                  @map("tenant_id") @db.Uuid
  key          String
  /// 1–16 of A–Z a–z 0–9 . _ / - (CHECK).
  prefix       String
  /// At most 64 characters with {seq:N} (CHECK); a yearly reset needs {YYYY} or {YY} (CHECK).
  pattern      String
  resetPolicy  NumberSeriesResetPolicy @map("reset_policy")
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  counters     NumberSeriesCounter[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("number_series")
}

/// The next number of one series in one period (`all` or a year). Only moves forward (trigger);
/// never deleted (DELETE revoked).
model NumberSeriesCounter {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  seriesId     String       @map("series_id") @db.Uuid
  /// `all` or a four-digit year (CHECK).
  period       String
  /// ≥ 1 (CHECK).
  nextValue    BigInt       @default(1) @map("next_value")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  series       NumberSeries @relation(fields: [tenantId, seriesId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, seriesId, period])
  @@map("number_series_counters")
}

// ---------------------------------------------------------------------------
// Outbox (docs/platform/outbox.md, ADR 0013)
// ---------------------------------------------------------------------------

/// An event written in the business transaction, published to BullMQ by the worker. The app may
/// update only the scheduling columns (column grants). Partial indexes on pending and published
/// rows are hand-written in the migration (Prisma can't express them; a catalog test guards them).
model OutboxEvent {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  /// `module.entity.past_tense`, registered in packages/shared/src/events (CHECK: shape only).
  type           String
  /// ≥ 1 (CHECK).
  version        Int
  /// Object, ≤ 8 KiB (CHECK). Ids, keys and enums only.
  payload        Json
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  /// Not claimed before this instant; moved forward by the dispatch backoff.
  availableAt    DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(6)
  /// Never together with published_at (CHECK).
  deadLetteredAt DateTime?    @map("dead_lettered_at") @db.Timestamptz(6)
  /// Failed dispatches.
  attempts       Int          @default(0)
  /// ≤ 2000 characters (CHECK).
  lastError      String?      @map("last_error")
  organization   Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@map("outbox_events")
}

/// One row per handler and event it applied, committed with the handler's effects. Insert and
/// delete only. No FK to outbox_events: published events are cleaned up first.
model ProcessedEvent {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  /// `module.camelCaseName` (CHECK).
  handler      String
  eventId      String       @map("event_id") @db.Uuid
  processedAt  DateTime     @default(now()) @map("processed_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, handler, eventId])
  @@index([tenantId, processedAt])
  @@map("processed_events")
}

// ---------------------------------------------------------------------------
// Idempotency (docs/platform/idempotency.md, ADR 0014)
// ---------------------------------------------------------------------------

enum IdempotencyKeyStatus {
  in_progress
  completed

  @@map("idempotency_key_status")
}

/// A client's Idempotency-Key for one route, kept 24 h. Shape rules are CHECKs in the migration.
model IdempotencyKey {
  id             String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  /// Method and route pattern, e.g. `PUT /api/v1/settings/:key`.
  route          String
  key            String
  /// SHA-256 hex of method, path with query, and body.
  requestHash    String               @map("request_hash")
  status         IdempotencyKeyStatus @default(in_progress)
  /// New on insert and on takeover; transaction completion matches on it.
  lockToken      String               @map("lock_token") @db.Uuid
  lockedUntil    DateTime             @map("locked_until") @db.Timestamptz(6)
  /// 200–499, set iff completed (CHECK).
  responseStatus Int?                 @map("response_status")
  responseBody   Json?                @map("response_body")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?            @map("completed_at") @db.Timestamptz(6)
  expiresAt      DateTime             @map("expires_at") @db.Timestamptz(6)
  organization   Organization         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, userId, route, key])
  @@index([tenantId, expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Catalog module (docs/modules/catalog.md, ADR 0016). Private to modules/catalog.
// Name uniqueness among non-archived rows is a partial unique index in the migration.
// ---------------------------------------------------------------------------

/// Where a category's items are prepared: its own ticket per station (ADR 0025).
enum PrepStation {
  kitchen
  bar

  @@map("prep_station")
}

model ProductCategory {
  id           String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String                @map("tenant_id") @db.Uuid
  name         String
  sortOrder    Int                   @default(0) @map("sort_order")
  /// Which ticket its items print on (ADR 0025).
  station      PrepStation           @default(kitchen)
  /// What belongs in it (ADR 0048); null = none.
  description  String?
  /// Its parent ("secondary") category (ADR 0048): one level only, checked by the service.
  parentId     String?               @map("parent_id") @db.Uuid
  archivedAt   DateTime?             @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parent       ProductCategory?      @relation("CategoryChildren", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  children     ProductCategory[]     @relation("CategoryChildren")
  products     Product[]
  priceRules   PriceRule[]
  image        ProductCategoryImage?
  stockItems   StockItem[]

  vendorInvoiceLines VendorInvoiceLine[]

  @@unique([tenantId, id])
  @@index([tenantId, parentId])
  @@map("product_categories")
}

/// A category's tile image (ADR 0048): resized by the browser, WebP/PNG/JPEG, at most 300 KB. Kept apart so lists stay light.
model ProductCategoryImage {
  tenantId     String          @map("tenant_id") @db.Uuid
  categoryId   String          @map("category_id") @db.Uuid
  contentType  String          @map("content_type")
  data         Bytes
  updatedAt    DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  category     ProductCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  organization Organization    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, categoryId])
  @@map("product_category_images")
}

/// `price` is gross (VAT included); `taxRate` a percentage. Archived, never deleted.
model Product {
  id           String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  categoryId   String          @map("category_id") @db.Uuid
  name         String
  /// ADR 0029; unique per tenant (lower) among non-archived rows: products_active_menu_number_key (SQL only).
  menuNumber   String?         @map("menu_number")
  description  String?
  price        Decimal         @db.Decimal(12, 2)
  taxRate      Decimal         @map("tax_rate") @db.Decimal(5, 2)
  sortOrder    Int             @default(0) @map("sort_order")
  archivedAt   DateTime?       @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category     ProductCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  orderLines   PosOrderLine[]
  priceRules   PriceRule[]
  image        ProductImage?

  @@unique([tenantId, id])
  @@index([tenantId, categoryId])
  @@map("products")
}

/// A product's picture (ADR 0049): resized by the browser to WebP/PNG/JPEG, at most 300 KB. Kept apart so lists stay light.
model ProductImage {
  tenantId     String       @map("tenant_id") @db.Uuid
  productId    String       @map("product_id") @db.Uuid
  contentType  String       @map("content_type")
  data         Bytes
  updatedAt    DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  product      Product      @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, productId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// POS module: table service (docs/modules/pos.md, ADR 0016). Private to modules/pos.
// ---------------------------------------------------------------------------

model DiningTable {
  id                      String                        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId                String                        @map("tenant_id") @db.Uuid
  locationId              String                        @map("location_id") @db.Uuid
  name                    String
  seats                   Int
  /// The area's name, kept equal to `dining_areas.name` while older releases read it (expand phase, ADR 0004).
  area                    String?
  areaId                  String?                       @map("area_id") @db.Uuid
  /// How the table is drawn on the floor and tables pages.
  shape                   DiningTableShape              @default(square)
  color                   DiningTableColor              @default(neutral)
  /// The QR menu link's secret part (ADR 0026): 24 URL-safe characters; rotated by staff.
  menuToken               String                        @default(dbgenerated("pos_new_menu_token()")) @map("menu_token")
  sortOrder               Int                           @default(0) @map("sort_order")
  /// Normalized position on the location floor canvas (0..1000).
  floorX                  Int                           @default(100) @map("floor_x")
  floorY                  Int                           @default(100) @map("floor_y")
  archivedAt              DateTime?                     @map("archived_at") @db.Timestamptz(6)
  createdAt               DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization            Organization                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location                Location                      @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  diningArea              DiningArea?                   @relation(fields: [tenantId, locationId, areaId], references: [tenantId, locationId, id], onDelete: Restrict, onUpdate: Restrict)
  orders                  PosOrder[]
  ordersAtLocation        PosOrder[]                    @relation("PosOrderTableAtLocation")
  reservationRules        ReservationTableRule[]
  reservationCombinations ReservationCombinationTable[]
  reservationTables       ReservationTable[]

  @@unique([tenantId, id])
  /// Hand-written in the pos_orders migration; target of composite FKs that pin a table to its location.
  @@unique([tenantId, id, locationId], map: "dining_tables_tenant_id_id_location_id_key")
  @@unique([tenantId, menuToken])
  @@index([tenantId, locationId])
  @@index([tenantId, areaId])
  @@map("dining_tables")
}

enum PosOrderStatus {
  open
  closed

  @@map("pos_order_status")
}

enum PosKitchenTicketKind {
  order
  void

  @@map("pos_kitchen_ticket_kind")
}

/// A table's order (docs/modules/pos.md → Step 3). At most one open order per table: a partial unique index in the
/// migration. User ids have no foreign key: users are platform rows private to platform/auth.
model PosOrder {
  id              String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  locationId      String             @map("location_id") @db.Uuid
  tableId         String             @map("table_id") @db.Uuid
  number          String
  status          PosOrderStatus     @default(open)
  /// Guests at the table, 1–100 (pos_orders_covers_check); null when not recorded.
  covers          Int?
  openedByUserId  String             @map("opened_by_user_id") @db.Uuid
  openedAt        DateTime           @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedByUserId  String?            @map("closed_by_user_id") @db.Uuid
  closedAt        DateTime?          @map("closed_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location        Location           @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  table           DiningTable        @relation(fields: [tenantId, tableId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Hand-written FK (pos_orders migration): the table is at the order's location. Declared so migrate diff keeps it; read `table`.
  tableAtLocation DiningTable        @relation("PosOrderTableAtLocation", fields: [tenantId, tableId, locationId], references: [tenantId, id, locationId], onDelete: Restrict, onUpdate: Restrict, map: "pos_orders_table_location_fkey")
  tickets         PosKitchenTicket[]
  lines           PosOrderLine[]

  printJobs        PosPrintJob[]
  billOrders       PosBillOrder[]
  discounts        PosOrderDiscount[]
  ticketPlacements PosTicketPlacement[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  /// Target of pos_bill_orders_order_location_fkey: a bill's orders are at its location.
  @@unique([tenantId, id, locationId])
  @@index([tenantId, locationId, status])
  @@index([tenantId, tableId])
  @@map("pos_orders")
}

/// One send to the kitchen (or one void). Append-only.
model PosKitchenTicket {
  id              String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  orderId         String                  @map("order_id") @db.Uuid
  sequence        Int
  kind            PosKitchenTicketKind
  /// Snapshot of the lines' category station at send time (ADR 0025).
  station         PrepStation             @default(kitchen)
  /// Went straight to the bill: the station's processing was off at send time (ADR 0031).
  direct          Boolean                 @default(false)
  /// The send that wrote it: one send writes up to two tickets (ADR 0081). Null on voids, transfers and older tickets.
  sendId          String?                 @map("send_id") @db.Uuid
  /// Written by a transfer, so it is not a round (ADR 0081).
  transferred     Boolean                 @default(false)
  createdByUserId String                  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order           PosOrder                @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  lines           PosOrderLine[]
  linesOfOrder    PosOrderLine[]          @relation("PosOrderLineTicketOfOrder")
  statusChanges   PosTicketStatusChange[]
  /// Which order the ticket belongs to, over time (ADR 0069); the latest row is the current one.
  placements      PosTicketPlacement[]

  printJobs PosPrintJob[]

  @@unique([tenantId, id])
  /// Hand-written in the pos_orders migration; target of pos_order_lines_ticket_order_fkey.
  @@unique([tenantId, orderId, id], map: "pos_kitchen_tickets_tenant_id_order_id_id_key")
  @@unique([tenantId, orderId, sequence])
  @@map("pos_kitchen_tickets")
}

/// Which order a kitchen ticket belongs to (ADR 0069). Append-only: a move or merge adds a row, and a line follows
/// its ticket's latest row. Every ticket gets its first row from a trigger, so the latest row always exists.
model PosTicketPlacement {
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Insertion order: the latest row of a ticket is the one with the highest seq (ids are not strictly ordered
  /// within one millisecond).
  seq             BigInt           @unique @default(autoincrement())
  tenantId        String           @map("tenant_id") @db.Uuid
  ticketId        String           @map("ticket_id") @db.Uuid
  orderId         String           @map("order_id") @db.Uuid
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ticket          PosKitchenTicket @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  order           PosOrder         @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, ticketId, seq])
  @@index([tenantId, orderId])
  @@map("pos_ticket_placements")
}

/// A ticket's progress on the kitchen or bar screen (ADR 0026); `new` is the absence of a change.
enum PosTicketStatus {
  preparing
  ready
  served

  @@map("pos_ticket_status")
}

/// One move of a ticket on its station's screen, or served from the till. Append-only; the latest row is the status.
model PosTicketStatusChange {
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  ticketId        String           @map("ticket_id") @db.Uuid
  status          PosTicketStatus
  changedByUserId String           @map("changed_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ticket          PosKitchenTicket @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, ticketId, createdAt])
  @@map("pos_ticket_status_changes")
}

/// A sent item (quantity > 0) or a void of one (quantity < 0, voidsLineId set). Append-only; name, gross unit price
/// and VAT rate are snapshots of the product at the time.
model PosOrderLine {
  id              String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  orderId         String                 @map("order_id") @db.Uuid
  ticketId        String                 @map("ticket_id") @db.Uuid
  productId       String                 @map("product_id") @db.Uuid
  productName     String                 @map("product_name")
  unitPrice       Decimal                @map("unit_price") @db.Decimal(12, 2)
  taxRate         Decimal                @map("tax_rate") @db.Decimal(5, 2)
  quantity        Int
  note            String?
  /// The guest's seat at the table, 1–20 (ADR 0070); null when not given. Fixed at send time.
  seat            Int?                   @db.SmallInt
  voidsLineId     String?                @map("voids_line_id") @db.Uuid
  createdByUserId String                 @map("created_by_user_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order           PosOrder               @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  ticket          PosKitchenTicket       @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  product         Product                @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  voidsLine       PosOrderLine?          @relation("PosOrderLineVoids", fields: [tenantId, voidsLineId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  voidedBy        PosOrderLine[]         @relation("PosOrderLineVoids")
  /// Hand-written FK (pos_orders migration): the ticket belongs to the line's order. Declared so migrate diff keeps it;
  /// read `ticket`. A void may be on another order than the line it voids: a merge moved the line (ADR 0069).
  ticketOfOrder   PosKitchenTicket       @relation("PosOrderLineTicketOfOrder", fields: [tenantId, orderId, ticketId], references: [tenantId, orderId, id], onDelete: Restrict, onUpdate: Restrict, map: "pos_order_lines_ticket_order_fkey")
  billItems       PosBillItem[]
  discountLines   PosOrderDiscountLine[]

  @@unique([tenantId, id])
  /// Hand-written in the pos_orders migration; nothing references it since 20261124120000 (dropped later, ADR 0004).
  @@unique([tenantId, orderId, id], map: "pos_order_lines_tenant_id_order_id_id_key")
  @@index([tenantId, orderId])
  @@index([tenantId, ticketId])
  @@index([tenantId, voidsLineId])
  @@map("pos_order_lines")
}

enum PosBillKind {
  single
  equal

  @@map("pos_bill_kind")
}

/// One act of billing (docs/modules/pos.md → Step 4, ADR 0036): items of 1–10 open orders at one location. Append-only;
/// cancelling writes a PosBillCancellation. User ids have no foreign key (platform rows).
model PosBill {
  id              String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  locationId      String               @map("location_id") @db.Uuid
  kind            PosBillKind
  /// Shares of an equal split, 2–20; null for a single bill (pos_bills_share_count_check).
  shareCount      Int?                 @map("share_count")
  createdByUserId String               @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location        Location             @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  orders          PosBillOrder[]
  items           PosBillItem[]
  checks          PosGuestCheck[]
  cancellation    PosBillCancellation?

  @@unique([tenantId, id])
  /// Target of pos_bill_orders_bill_location_fkey: a bill's orders are at its location.
  @@unique([tenantId, id, locationId])
  @@index([tenantId, locationId, createdAt])
  @@map("pos_bills")
}

/// The orders a bill covers (more than one: a merge). Append-only.
model PosBillOrder {
  tenantId     String        @map("tenant_id") @db.Uuid
  billId       String        @map("bill_id") @db.Uuid
  orderId      String        @map("order_id") @db.Uuid
  locationId   String        @map("location_id") @db.Uuid
  organization Organization  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bill         PosBill       @relation(fields: [tenantId, billId, locationId], references: [tenantId, id, locationId], onDelete: Restrict, onUpdate: Restrict, map: "pos_bill_orders_bill_location_fkey")
  order        PosOrder      @relation(fields: [tenantId, orderId, locationId], references: [tenantId, id, locationId], onDelete: Restrict, onUpdate: Restrict, map: "pos_bill_orders_order_location_fkey")
  items        PosBillItem[]

  @@id([tenantId, billId, orderId])
  @@index([tenantId, orderId])
  @@map("pos_bill_orders")
}

/// Billed portions of an order line, with snapshots for the check. Append-only.
model PosBillItem {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  billId         String       @map("bill_id") @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  orderLineId    String       @map("order_line_id") @db.Uuid
  productName    String       @map("product_name")
  unitPrice      Decimal      @map("unit_price") @db.Decimal(12, 2)
  taxRate        Decimal      @map("tax_rate") @db.Decimal(5, 2)
  quantity       Int
  /// The discount on these portions, negative, gross (ADR 0036 §5); 0 without one.
  discountAmount Decimal      @default(0) @map("discount_amount") @db.Decimal(12, 2)
  organization   Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bill           PosBill      @relation(fields: [tenantId, billId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  billOrder      PosBillOrder @relation(fields: [tenantId, billId, orderId], references: [tenantId, billId, orderId], onDelete: Restrict, onUpdate: Restrict, map: "pos_bill_items_bill_order_fkey")
  orderLine      PosOrderLine @relation(fields: [tenantId, orderLineId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, billId])
  @@index([tenantId, orderLineId])
  @@map("pos_bill_items")
}

/// A printed, numbered guest check ("Zwischenrechnung", ADR 0016 §3): the whole bill (share_index 0) or one share
/// of an equal split (1..n). Append-only; reprints print the same row.
model PosGuestCheck {
  id           String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  billId       String               @map("bill_id") @db.Uuid
  number       String
  shareIndex   Int                  @default(0) @map("share_index")
  gross        Decimal              @db.Decimal(12, 2)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bill         PosBill              @relation(fields: [tenantId, billId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  shares       PosGuestCheckShare[]
  printJobs    PosPrintJob[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, billId, shareIndex])
  @@index([tenantId, createdAt])
  @@map("pos_guest_checks")
}

/// A share check's gross per VAT rate (equal split). Append-only.
model PosGuestCheckShare {
  tenantId     String        @map("tenant_id") @db.Uuid
  checkId      String        @map("check_id") @db.Uuid
  taxRate      Decimal       @map("tax_rate") @db.Decimal(5, 2)
  gross        Decimal       @db.Decimal(12, 2)
  organization Organization  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  check        PosGuestCheck @relation(fields: [tenantId, checkId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, checkId, taxRate])
  @@map("pos_guest_check_shares")
}

/// Cancels a bill: its checks print "CANCELLED" and its items can be billed again. At most one per bill. Append-only.
model PosBillCancellation {
  tenantId          String       @map("tenant_id") @db.Uuid
  billId            String       @map("bill_id") @db.Uuid
  reason            String
  cancelledByUserId String       @map("cancelled_by_user_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization      Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bill              PosBill      @relation(fields: [tenantId, billId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, billId])
  @@map("pos_bill_cancellations")
}

enum PosDiscountKind {
  percent
  amount

  @@map("pos_discount_kind")
}

/// A discount or comp on an order line, or on the whole order (ADR 0036 §5). Append-only; removing one writes a row
/// that points at it (voidsDiscountId). Its amounts per line are PosOrderDiscountLine rows.
model PosOrderDiscount {
  id              String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  orderId         String                 @map("order_id") @db.Uuid
  /// Null: the whole order.
  orderLineId     String?                @map("order_line_id") @db.Uuid
  kind            PosDiscountKind
  /// Percent 0 < v <= 100, or the amount given (positive).
  value           Decimal                @db.Decimal(12, 2)
  reason          String
  voidsDiscountId String?                @map("voids_discount_id") @db.Uuid
  createdByUserId String                 @map("created_by_user_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order           PosOrder               @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  lines           PosOrderDiscountLine[]

  @@unique([tenantId, id])
  @@index([tenantId, orderId])
  @@map("pos_order_discounts")
}

/// The part of a discount on one line: a negative gross amount at the line's VAT rate. Append-only.
model PosOrderDiscountLine {
  tenantId     String           @map("tenant_id") @db.Uuid
  discountId   String           @map("discount_id") @db.Uuid
  orderId      String           @map("order_id") @db.Uuid
  orderLineId  String           @map("order_line_id") @db.Uuid
  taxRate      Decimal          @map("tax_rate") @db.Decimal(5, 2)
  amount       Decimal          @db.Decimal(12, 2)
  organization Organization     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  discount     PosOrderDiscount @relation(fields: [tenantId, discountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  orderLine    PosOrderLine     @relation(fields: [tenantId, orderLineId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, discountId, orderLineId])
  @@map("pos_order_discount_lines")
}

enum DiningTableShape {
  square
  round
  long

  @@map("dining_table_shape")
}

/// Colour keys, not colours: the web app maps each to a theme token (ADR 0015).
