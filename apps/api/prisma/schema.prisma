  bom          Bom          @relation(fields: [tenantId, bomId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  item         StockItem    @relation("BomComponent", fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

