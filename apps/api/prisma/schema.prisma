  @@index([tenantId, userId])
  @@map("push_subscriptions")
}

/// A vendor invoice read from its PDF or photo, waiting for approval (ADR 0054). Approval books one receipt.
model VendorInvoice {
  lineCorrections VendorInvoiceLineCorrection[]
  id              String                        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String                        @map("tenant_id") @db.Uuid
  number          String
  status          String                        @default("pending")
  warehouseId     String                        @map("warehouse_id") @db.Uuid
  supplier        String?
  invoiceNumber   String?                       @map("invoice_number")
  invoiceDate     String?                       @map("invoice_date")
  note            String?
  printedTotal    Decimal?                      @map("printed_total") @db.Decimal(12, 2)
  fileName        String?                       @map("file_name")
  source          String
  submittedBy     String                        @map("submitted_by") @db.Uuid
  decidedBy       String?                       @map("decided_by") @db.Uuid
